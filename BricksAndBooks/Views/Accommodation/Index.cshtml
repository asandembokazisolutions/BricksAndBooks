@model IEnumerable<BricksAndBooks.Models.Accommodation>
@using System.Collections.Generic
@{
    ViewData["Title"] = "Find accommodation";
    var accommodations = Model.ToList();
    decimal? rentRate = ViewBag.MonthlyRentRate as decimal?;
    var fallback = Url.Content("~/images/residence-hero.jpg");
    var reviewCounts = ViewBag.ReviewCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var reviewAverages = ViewBag.ReviewAverages as Dictionary<int, double> ?? new Dictionary<int, double>();
}
<section class="residence-hero">
    <div class="residence-hero-copy">
        <div class="residence-eyebrow"><span class="eyebrow-mark"><i class="fa-solid fa-house"></i></span> BRICKS &amp; BOOKS <span class="eyebrow-divider">/</span> UNIVERSITY RESIDENCES</div>
        <h1>Find a place that<br /><span>feels like yours.</span></h1>
        <p>Explore residence options, compare availability and find a space that fits your student life.</p>
        <div class="hero-proof"><span><i class="fa-solid fa-circle-check"></i> University residence listings</span><span><i class="fa-solid fa-magnifying-glass"></i> Search by name or area</span></div>
    </div>
    <div class="residence-search-panel">
        <label class="search-field search-destination"><span class="search-icon"><i class="fa-solid fa-location-dot"></i></span><span class="search-copy"><small>DESTINATION</small><input id="stay-search" type="search" placeholder="Residence name or area" autocomplete="off" /></span></label>
        <label class="search-field"><span class="search-icon"><i class="fa-solid fa-door-open"></i></span><span class="search-copy"><small>AVAILABILITY</small><select id="availability-filter"><option value="all">Any availability</option><option value="available">Available rooms</option></select></span></label>
        <button type="button" class="residence-search-button" id="search-stays"><i class="fa-solid fa-arrow-right"></i><span>Search residences</span></button>
    </div>
    <div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div>
</section>
@if (TempData["UnitNavigationMessage"] != null) { <div class="alert alert-info mt-4">@TempData["UnitNavigationMessage"]</div> }
<section class="residence-results">
    <header class="results-header">
        <div><span class="section-eyebrow">YOUR NEXT CHAPTER</span><h2>Explore residences</h2><p>Compare rooms, location, monthly pricing and resident feedback.</p></div>
        <div class="results-header-right"><span class="results-count"><span class="count-dot"></span><strong id="stay-result-count">@accommodations.Count</strong> residences</span>@if (User.IsInRole("Admin")) { <a asp-action="Create" class="add-residence-button"><i class="fa-solid fa-plus"></i> Add residence</a> }</div>
    </header>
    @if (!accommodations.Any())
    {
        <div class="residence-empty"><span class="empty-building"><i class="fa-solid fa-building-circle-exclamation"></i></span><h3>No residences listed yet</h3><p>Residence options will appear here when they are added to the portal.</p>@if (User.IsInRole("Admin")) { <a asp-action="Create" class="add-residence-button"><i class="fa-solid fa-plus"></i> Add a residence</a> }</div>
    }
    else
    {
        <div class="residence-list" id="stay-results">
        @foreach (var item in accommodations)
        {
            var coverImage = item.ImageUrls?.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).FirstOrDefault();
            var available = item.Units.Count(unit => unit.IsAvailable);
            var totalUnits = item.Units.Count;
            var searchable = $"{item.Name} {item.Address} {item.Description}".ToLowerInvariant();
            var reviewCount = reviewCounts.TryGetValue(item.Id, out var count) ? count : 0;
            var reviewAverage = reviewAverages.TryGetValue(item.Id, out var average) ? average : 0;
            <article class="residence-card" data-search="@searchable" data-available="@(available > 0 ? "true" : "false")">
                <a class="residence-photo" asp-action="Details" asp-route-id="@item.Id" aria-label="View @item.Name">
                    <img src="@(string.IsNullOrWhiteSpace(coverImage) ? fallback : Url.Content(coverImage))" alt="Residence at @item.Name" loading="lazy" onerror="this.onerror=null;this.src='@fallback';" />
                    <span class="photo-count"><i class="fa-regular fa-images"></i> Residence photos</span>
                    <span class="photo-corner-mark"><i class="fa-solid fa-arrow-up-right-from-square"></i></span>
                </a>
                <div class="residence-card-content">
                    <div class="residence-heading-row">
                        <div class="residence-title-block"><span class="verified-label"><i class="fa-solid fa-circle-check"></i> BRICKS &amp; BOOKS RESIDENCE</span><h3><a asp-action="Details" asp-route-id="@item.Id">@item.Name</a></h3></div>
                        @if (reviewCount > 0)
                        {
                            <div class="rating-chip"><span class="rating-value">@reviewAverage.ToString("0.0")</span><span class="rating-star"><i class="fa-solid fa-star"></i></span><span class="rating-total">@reviewCount review@(reviewCount == 1 ? "" : "s")</span></div>
                        }
                        else
                        {
                            <div class="rating-chip unrated"><span class="rating-value">New</span><span class="rating-total">No ratings yet</span></div>
                        }
                    </div>
                    <p class="residence-address"><i class="fa-solid fa-location-dot"></i><span>@item.Address</span></p>
                    <p class="residence-description">@(string.IsNullOrWhiteSpace(item.Description) ? "Student residence with support from the Bricks & Books residence team." : item.Description)</p>
                    <div class="residence-features">
                        <span><i class="fa-solid fa-door-open"></i><strong>@totalUnits</strong> room@(totalUnits == 1 ? "" : "s")</span>
                        <span><i class="fa-solid fa-bed"></i><strong>@available</strong> available</span>
                        <span><i class="fa-solid fa-people-group"></i>Single &amp; shared options</span>
                    </div>
                </div>
                <aside class="residence-offer">
                    <span class="availability-label @(available > 0 ? "available" : "full")"><span class="status-dot"></span>@(available > 0 ? $"{available} room{(available == 1 ? "" : "s")} available" : "Currently full")</span>
                    <div class="offer-price">
                        @if (rentRate.HasValue)
                        {
                            <span class="price-caption">MONTHLY RENT FROM</span><strong>@rentRate.Value.ToString("C")</strong><span class="price-footnote">Per month · utilities may be separate</span>
                        }
                        else
                        {
                            <span class="price-caption">MONTHLY RENT</span><strong class="price-contact">Ask residence team</strong><span class="price-footnote">Rates not listed online</span>
                        }
                    </div>
                    <a asp-action="Details" asp-route-id="@item.Id" class="view-residence-button">View residence <i class="fa-solid fa-arrow-right"></i></a>
                    @if ((User.IsInRole("Student") || User.IsInRole("Staff")) && !(ViewBag.HasActiveAccommodation ?? false)) { <a asp-controller="AccommodationApplication" asp-action="Apply" class="apply-residence-link">Apply for accommodation</a> }
                    @if (User.IsInRole("Admin")) { <div class="admin-actions"><a asp-controller="Unit" asp-action="Index" asp-route-accommodationId="@item.Id">Manage rooms</a><a asp-action="Delete" asp-route-id="@item.Id">Delete</a></div> }
                </aside>
            </article>
        }
        </div>
        <div id="stay-empty-search" class="residence-empty search-empty" hidden><span class="empty-building"><i class="fa-solid fa-magnifying-glass"></i></span><h3>No matching residences</h3><p>Try another residence name or change the availability filter.</p><button type="button" class="reset-search" id="reset-stay-search">Clear search</button></div>
    }
</section>

nt-weight:700}.apply-residence-link:hover{text-decoration:underline}.admin-actions{display:flex;justify-content:space-between;gap:10px;border-top:1px solid #e6edef;padding-top:9px}.admin-actions a{color:#607984;text-decoration:none;font-size:.67rem;font-weight:700}.admin-actions a:last-child{color:#a74b4b}.admin-actions a:hover{text-decoration:underline}.residence-empty{display:grid;justify-items:center;padding:55px 20px;border:1px dashed #cbd9de;border-radius:18px;background:#fbfdfd;text-align:center}.empty-building{display:grid;place-items:center;width:54px;height:54px;margin-bottom:13px;border-radius:16px;background:#e8f4f2;color:#0d777a;font-size:1.15rem}.residence-empty h3{margin:0 0 7px;color:#15394c;font-size:1.16rem;font-weight:760}.residence-empty p{margin:0 0 16px;color:#6d7f87;font-size:.84rem}.search-empty[hidden]{display:none!important}.reset-search{border:0;background:transparent;color:#087887;font-size:.8rem;font-weight:750;text-decoration:underline}@@media(max-width:1050px){.residence-card{grid-template-columns:minmax(220px,30%) minmax(230px,1fr) 205px}.residence-card-content{padding:18px}.residence-features{gap:6px}.residence-features span{padding:6px 7px;font-size:.64rem}}@@media(max-width:800px){.residence-hero{padding:28px 22px 20px}.residence-search-panel{grid-template-columns:1fr 1fr;row-gap:5px}.search-field{padding:7px 11px}.search-destination{border-right:1px solid #e5ebef}.residence-search-button{grid-column:1/-1;min-height:46px}.residence-card{grid-template-columns:minmax(215px,38%) minmax(0,1fr)}.residence-photo{grid-row:1/3;min-height:280px}.residence-offer{grid-column:2;display:grid;grid-template-columns:1fr auto;align-items:center;border-left:0;border-top:1px solid #e9eef0;padding:13px 17px}.availability-label{grid-column:1/-1;justify-self:start}.offer-price{text-align:left;margin:0}.view-residence-button{min-width:145px}.apply-residence-link,.admin-actions{grid-column:1/-1}.rating-chip{padding:6px}.residence-heading-row{gap:8px}}@@med
@model IEnumerable<BricksAndBooks.Models.Accommodation>

@{
    ViewData["Title"] = "Accommodation";
    var accommodations = Model.ToList();
}

<div class="page-intro d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="eyebrow">Residence services</span>
        <h2 class="mb-1">Find accommodation</h2>
        <p class="text-muted mb-0">Explore available residences and submit an application for your preferred home.</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>Add accommodation</a>
    }
</div>

@if (TempData["UnitNavigationMessage"] != null)
{
    <div class="alert alert-info mb-4"><i class="fa-solid fa-circle-info me-2"></i>@TempData["UnitNavigationMessage"]</div>
}

@if (!accommodations.Any())
{
    <div class="card empty-state text-center p-5">
        <span class="empty-icon mx-auto mb-3"><i class="fa-solid fa-building"></i></span>
        <h3 class="h5">No residences are available yet</h3>
        <p class="text-muted mb-0">Residence information will appear here once it has been published.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in accommodations)
        {
            <div class="col-md-6 col-xl-4">
                <article class="card residence-directory-card h-100">
                    @{ var coverImage = item.ImageUrls?.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).FirstOrDefault(); }
                    <div class="residence-card-banner">@if (!string.IsNullOrWhiteSpace(coverImage)) { <img src="@Url.Content(coverImage)" alt="Photo of @item.Name" loading="lazy" /> } else { <i class="fa-solid fa-building-columns"></i> }</div>
                    <div class="card-body d-flex flex-column">
                        <span class="eyebrow">University residence</span>
                        <h3 class="h5 mt-2 mb-2">@item.Name</h3>
                        <p class="text-muted small mb-3"><i class="fa-solid fa-location-dot me-2 text-primary"></i>@item.Address</p>
                        <p class="small flex-grow-1">@(string.IsNullOrWhiteSpace(item.Description) ? "Managed accommodation with residence support and student-focused services." : item.Description)</p>
                        <div class="d-flex gap-2 pt-3 border-top">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm flex-grow-1">View details</a>
                            @if ((User.IsInRole("Student") || User.IsInRole("Staff")) && !(ViewBag.HasActiveAccommodation ?? false))
                            {
                                <a asp-controller="AccommodationApplication" asp-action="Apply" class="btn btn-primary btn-sm">Apply</a>
                            }
                            else if ((User.IsInRole("Student") || User.IsInRole("Staff")) && (ViewBag.HasActiveAccommodation ?? false))
                            {
                                <span class="badge text-bg-success align-self-center">Already allocated</span>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Unit" asp-action="Index" asp-route-accommodationId="@item.Id" class="btn btn-light btn-sm" title="Manage units"><i class="fa-solid fa-sliders"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Delete accommodation"><i class="fa-solid fa-trash"></i><span class="visually-hidden">Delete @item.Name</span></a>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}

<style>
    .residence-directory-card { overflow: hidden; transition: transform .18s ease, box-shadow .18s ease; }
    .residence-directory-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
    .residence-card-banner { min-height: 112px; display: grid; place-items: center; color: #fff; font-size: 2.2rem; background: linear-gradient(120deg, var(--navy-deep), var(--navy)); overflow: hidden; }
    .residence-card-banner img { width: 100%; height: 150px; object-fit: cover; }
</style>

</style>
@section Scripts {
<script>
(() => {
    const search = document.getElementById('stay-search');
    const availability = document.getElementById('availability-filter');
    const cards = Array.from(document.querySelectorAll('.residence-card'));
    const empty = document.getElementById('stay-empty-search');
    const counter = document.getElementById('stay-result-count');
    const runSearch = () => {
        const term = (search?.value || '').trim().toLocaleLowerCase();
        const availableOnly = availability?.value === 'available';
        let visible = 0;
        cards.forEach(card => {
            const textMatches = (card.dataset.search || '').includes(term);
            const availabilityMatches = !availableOnly || card.dataset.available === 'true';
            card.hidden = !(textMatches && availabilityMatches);
            if (!card.hidden) visible++;
        });
        if (counter) counter.textContent = visible.toString();
        if (empty) empty.hidden = visible > 0;
    };
    search?.addEventListener('input', runSearch);
    availability?.addEventListener('change', runSearch);
    document.getElementById('search-stays')?.addEventListener('click', runSearch);
    document.getElementById('reset-stay-search')?.addEventListener('click', () => {
        if (search) search.value = '';
        if (availability) availability.value = 'all';
        runSearch();
    });
})();
</script>
}

@model BricksAndBooks.Models.Accommodation
@using System.Linq
@using System.Collections.Generic
@{
    ViewData["Title"] = Model.Name;
    var images = (Model.ImageUrls ?? string.Empty).Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
    var fallbackImage = Url.Content("~/images/residence-hero.jpg");
    var reviews = (ViewBag.ResidenceReviews as IEnumerable<BricksAndBooks.Models.Review> ?? Enumerable.Empty<BricksAndBooks.Models.Review>()).ToList();
    var averageRating = reviews.Any() ? reviews.Average(review => review.Rating) : 0;
    var availableUnits = Model.Units.Count(unit => unit.IsAvailable);
    decimal? rentRate = ViewBag.MonthlyRentRate as decimal?;
    var unitImages = images.Skip(1).Take(4).ToList();
}
<nav class="property-breadcrumb" aria-label="Breadcrumb"><a asp-action="Index"><i class="fa-solid fa-arrow-left"></i> All residences</a><span>/</span><span>@Model.Name</span></nav>
<header class="property-heading">
    <div class="property-heading-copy"><span class="property-eyebrow"><i class="fa-solid fa-house"></i> BRICKS &amp; BOOKS RESIDENCE</span><h1>@Model.Name</h1><p class="property-address"><i class="fa-solid fa-location-dot"></i>@Model.Address</p>
        <div class="property-summary">
            @if (reviews.Any()) { <span class="summary-rating"><b>@averageRating.ToString("0.0")</b><i class="fa-solid fa-star"></i> <span>@reviews.Count review@(reviews.Count == 1 ? "" : "s")</span></span> }
            else { <span class="summary-rating no-rating">No approved reviews yet</span> }
            <span class="summary-separator">·</span><span><i class="fa-solid fa-bed"></i> @Model.Units.Count room@(Model.Units.Count == 1 ? "" : "s")</span>
            <span class="summary-separator">·</span><span><i class="fa-solid fa-door-open"></i> @availableUnits available now</span>
        </div>
    </div>
    <div class="property-heading-actions">
        @if (User.IsInRole("Admin")) { <a asp-action="Edit" asp-route-id="@Model.Id" class="property-outline-button"><i class="fa-solid fa-pen-to-square"></i> Edit listing</a> }
    </div>
</header>
<section class="property-gallery" aria-label="Residence photos">
    <a class="gallery-main" href="@(images.Any() ? Url.Content(images[0]) : fallbackImage)" target="_blank" rel="noopener"><img src="@(images.Any() ? Url.Content(images[0]) : fallbackImage)" alt="Main residence photo for @Model.Name" onerror="this.onerror=null;this.src='@fallbackImage';" /><span class="gallery-caption"><i class="fa-regular fa-images"></i> Residence gallery</span></a>
    @if (unitImages.Any())
    {
        <div class="gallery-side">
            @for (var index = 0; index < unitImages.Count; index++)
            {
                var photo = unitImages[index];
                <a href="@Url.Content(photo)" target="_blank" rel="noopener" class="gallery-tile">
                    <img src="@Url.Content(photo)" alt="Residence photo @(index + 2) for @Model.Name" loading="lazy" onerror="this.onerror=null;this.src='@fallbackImage';" />
                    @if (index == unitImages.Count - 1 && images.Count > 5)
                    {
                        <span class="gallery-more">+@(images.Count - 5) more</span>
                    }
                </a>
            }
            @for (var emptyTile = unitImages.Count; emptyTile < 4; emptyTile++)
            {
                <div class="gallery-placeholder"><i class="fa-solid fa-house-chimney-window"></i><span>Residence</span></div>
            }
        </div>
    }
    else
    {
        <div class="gallery-side gallery-empty-side"><div class="gallery-placeholder"><i class="fa-solid fa-house-chimney-window"></i><span>Residence</span></div><div class="gallery-placeholder"><i class="fa-solid fa-bed"></i><span>Rooms</span></div><div class="gallery-placeholder"><i class="fa-solid fa-tree-city"></i><span>Community</span></div><div class="gallery-placeholder"><i class="fa-solid fa-sun"></i><span>Your new view</span></div></div>
    }
</section>
<div class="property-content-grid">
    <main class="property-main-column">
        <section class="property-section about-section"><div class="section-title-row"><div><span class="section-eyebrow">THE RESIDENCE</span><h2>A little about this place</h2></div><span class="managed-stamp"><i class="fa-solid fa-shield-heart"></i> Bricks &amp; Books residence</span></div><p class="about-copy">@(string.IsNullOrWhiteSpace(Model.Description) ? "Residence information will be updated by the Bricks & Books team. Contact the residence office for current details about the community, facilities and services." : Model.Description)</p>
            <div class="property-facts"><div><span class="fact-icon"><i class="fa-solid fa-door-open"></i></span><span><small>ROOMS / UNITS</small><strong>@Model.Units.Count</strong></span></div><div><span class="fact-icon"><i class="fa-solid fa-circle-check"></i></span><span><small>AVAILABLE NOW</small><strong>@availableUnits</strong></span></div><div><span class="fact-icon"><i class="fa-solid fa-people-group"></i></span><span><small>ROOM OPTIONS</small><strong>Single &amp; shared</strong></span></div></div>
        </section>
        <section class="property-section rooms-section"><div class="section-title-row"><div><span class="section-eyebrow">FIND YOUR ROOM</span><h2>Room availability</h2><p>Choose a room option and check its current status.</p></div><span class="room-count-badge">@availableUnits available</span></div>
            @if (Model.Units.Any())
            {
                <div class="room-list">
                    @foreach (var unit in Model.Units.OrderBy(unit => unit.UnitNumber))
                    {
                        <article class="room-option"><span class="room-icon"><i class="fa-solid @(unit.OccupancyType == BricksAndBooks.Models.UnitOccupancyType.Shared ? "fa-people-roof" : "fa-bed")"></i></span><div class="room-info"><strong>@(unit.OccupancyType == BricksAndBooks.Models.UnitOccupancyType.Shared ? "Shared room" : "Single room") <span>· Unit @unit.UnitNumber</span></strong><small>Capacity: @unit.Capacity @(unit.Capacity == 1 ? "resident" : "residents")</small></div><span class="room-status @(unit.IsAvailable ? "open" : "occupied")"><i class="fa-solid @(unit.IsAvailable ? "fa-circle-check" : "fa-circle-minus")"></i> @(unit.IsAvailable ? "Available" : "Occupied")</span></article>
                    }
                </div>
            }
            else { <div class="room-empty"><i class="fa-solid fa-door-closed"></i><span>Room information is not available yet.</span></div> }
        </section>
        <section class="property-section reviews-section"><div class="section-title-row"><div><span class="section-eyebrow">RESIDENT VOICES</span><h2>Reviews &amp; ratings</h2><p>Feedback published for this residence.</p></div>@if (reviews.Any()) { <div class="review-summary"><strong>@averageRating.ToString("0.0")</strong><span><i class="fa-solid fa-star"></i> average<br /><small>@reviews.Count approved review@(reviews.Count == 1 ? "" : "s")</small></span></div> }</div>
            @if (reviews.Any())
            {
                <div class="review-list">
                    @foreach (var review in reviews)
                    {
                        var reviewerName = string.IsNullOrWhiteSpace(review.User?.FirstName) ? "Residence resident" : $"{review.User.FirstName} {(string.IsNullOrWhiteSpace(review.User.LastName) ? string.Empty : review.User.LastName.Substring(0, 1) + ".")}";
                        <article class="review-card"><div class="review-top"><div><strong>@review.Title</strong><span>@reviewerName · @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span></div><span class="review-score"><i class="fa-solid fa-star"></i> @review.Rating / 5</span></div><p>@review.Comment</p></article>
                    }
                </div>
            }
            else { <div class="no-reviews"><span><i class="fa-regular fa-comment-dots"></i></span><div><strong>Be the first to share your experience</strong><p>There are no approved reviews for this residence yet.</p></div></div> }
            @if (User.IsInRole("Student") || User.IsInRole("Staff")) { <a asp-controller="Review" asp-action="Create" class="review-cta"><i class="fa-regular fa-star"></i> Write a review</a> }
        </section>
    </main>
    <aside class="property-booking-column">
        <section class="availability-card"><span class="availability-card-eyebrow">YOUR RESIDENCE SNAPSHOT</span><h2>Ready to find your place?</h2><p>Check availability and apply through the residence portal.</p><div class="snapshot-availability"><span class="snapshot-dot @(availableUnits > 0 ? "is-open" : "is-closed")"></span><div><strong>@(availableUnits > 0 ? $"{availableUnits} rooms currently available" : "No rooms currently available")</strong><small>@Model.Units.Count total room@(Model.Units.Count == 1 ? "" : "s") listed</small></div></div>
            <div class="snapshot-price">
                @if (rentRate.HasValue)
                {
                    <span>MONTHLY RENT FROM</span>
                    <strong>@rentRate.Value.ToString("C")</strong>
                    <small>per month · utilities may be separate</small>
                }
                else
                {
                    <span>MONTHLY RENT</span>
                    <strong class="contact-rate">Contact residence office</strong>
                    <small>Rates are not listed online</small>
                }
            </div>
            @if ((User.IsInRole("Student") || User.IsInRole("Staff")) && !(ViewBag.HasActiveAccommodation ?? false))
            {
                if (availableUnits > 0) { <a asp-controller="AccommodationApplication" asp-action="Apply" class="apply-button">Apply for accommodation <i class="fa-solid fa-arrow-right"></i></a> }
                else { <button class="apply-button disabled" type="button" disabled>Currently full</button> }
            }
            else if (!User.Identity?.IsAuthenticated ?? true) { <a asp-controller="Account" asp-action="Login" class="apply-button">Sign in to apply <i class="fa-solid fa-arrow-right"></i></a> }
            <div class="assistance-note"><i class="fa-solid fa-circle-info"></i><span>Questions about this residence? Contact the Bricks &amp; Books residence team.</span></div>
        </section>
        @if (User.IsInRole("Admin")) { <a asp-controller="Unit" asp-action="Create" asp-route-accommodationId="@Model.Id" class="admin-add-room"><i class="fa-solid fa-plus"></i> Add a room / unit</a> }
    </aside>
</div>

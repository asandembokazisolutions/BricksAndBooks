@{
    ViewData["Title"] = "Submit Feedback";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header"><h2 class="h5 mb-1">Share your feedback</h2><p class="text-muted small mb-0">Tell the estate team about your accommodation experience, service quality, or a concern.</p></div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3"><label for="accommodationId" class="form-label">Accommodation</label><select id="accommodationId" name="accommodationId" class="form-select" asp-items="ViewBag.Accommodations" required><option value="">Choose accommodation</option></select></div>
                    <div class="mb-3"><label for="rating" class="form-label">Rating</label><select id="rating" name="rating" class="form-select" required><option value="">Choose rating</option><option value="5">5 — Excellent</option><option value="4">4 — Good</option><option value="3">3 — Fair</option><option value="2">2 — Poor</option><option value="1">1 — Very poor</option></select></div>
                    <div class="mb-3"><label for="title" class="form-label">Subject</label><input id="title" name="title" class="form-control" maxlength="200" required /></div>
                    <div class="mb-4"><label for="comment" class="form-label">Feedback or complaint</label><textarea id="comment" name="comment" class="form-control" rows="6" maxlength="2000" required></textarea><div class="form-text">Maximum 2,000 characters. Your review is posted directly to the selected residence page.</div></div>
                    <button type="submit" class="btn btn-primary">Post feedback</button><a asp-controller="Home" asp-action="Index" class="btn btn-light">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@model IEnumerable<BricksAndBooks.Models.Review>
@{
    ViewData["Title"] = "Customer feedback";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h2 class="mb-1">Customer feedback</h2>
        <p class="text-muted mb-0">Reviews are posted directly to their residence page when submitted. Use this list to view the feedback received across managed residences.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-primary"><i class="fa-solid fa-rotate me-2"></i>Refresh</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-3">Customer</th>
                    <th>Residence</th>
                    <th>Rating</th>
                    <th>Feedback</th>
                    <th>Posted</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="ps-3">@item.User?.UserName</td>
                    <td>@item.Accommodation?.Name</td>
                    <td>
                        <span class="review-stars" aria-label="@item.Rating out of 5 stars">
                            @for (var star = 1; star <= 5; star++)
                            {
                                <i class="fa-solid fa-star @(star <= item.Rating ? "text-warning" : "text-muted")"></i>
                            }
                        </span>
                    </td>
                    <td><strong>@item.Title</strong><div class="small text-muted text-truncate" style="max-width: 25rem;">@item.Comment</div></td>
                    <td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                    <td class="text-end pe-3"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">View feedback</a></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-5">No customer feedback has been posted yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

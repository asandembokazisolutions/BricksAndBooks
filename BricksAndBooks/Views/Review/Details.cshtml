@model BricksAndBooks.Models.Review
@{
    ViewData["Title"] = "Feedback details";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="eyebrow">Customer feedback</span>
        <h2 class="mt-2 mb-1">@Model.Title</h2>
        <p class="text-muted mb-0">Posted @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm") for @Model.Accommodation?.Name</p>
    </div>
    <a asp-action="Index" class="btn btn-light"><i class="fa-solid fa-arrow-left me-2"></i>Back to feedback</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="small text-muted mb-1">Customer</div>
                <div class="fw-semibold">@Model.User?.UserName</div>
            </div>
            <div class="col-md-4">
                <div class="small text-muted mb-1">Residence</div>
                <div class="fw-semibold">@Model.Accommodation?.Name</div>
            </div>
            <div class="col-md-4">
                <div class="small text-muted mb-1">Rating</div>
                <div class="review-stars fs-5" aria-label="@Model.Rating out of 5 stars">
                    @for (var star = 1; star <= 5; star++)
                    {
                        <i class="fa-solid fa-star @(star <= Model.Rating ? "text-warning" : "text-muted")"></i>
                    }
                </div>
            </div>
            <div class="col-12"><hr class="my-2" /></div>
            <div class="col-12">
                <div class="small text-muted mb-2">Review</div>
                <p class="mb-0" style="white-space: pre-line;">@Model.Comment</p>
            </div>
        </div>
    </div>
</div>

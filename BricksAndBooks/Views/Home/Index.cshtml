@model BricksAndBooks.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Find your place at UFS";
    ViewData["MetaDescription"] = "Explore Bricks & Books residences, compare available units, and start your UFS accommodation application.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var fallbackImage = Url.Content("~/images/residence-hero.jpg");
}

<section class="landing-hero" aria-labelledby="landing-title">
    <div class="landing-hero-media" aria-hidden="true"></div>
    <div class="landing-hero-shade" aria-hidden="true"></div>
    <div class="landing-hero-content">
        <div class="landing-kicker"><span class="landing-kicker-mark"></span> Bricks &amp; Books · UFS residence living</div>
        <h1 id="landing-title">Find your place<br /><em>at UFS.</em></h1>
        <p class="landing-hero-copy">A simpler way to discover residence, apply with confidence, and stay on top of everything after move-in.</p>
        <div class="landing-hero-actions">
            <a href="#residences" class="btn btn-saffron btn-lg"><span>Explore residences</span><i class="fa-solid fa-arrow-down-long" aria-hidden="true"></i></a>
            @if (!(User.Identity?.IsAuthenticated ?? false))
            {
                <a asp-controller="Account" asp-action="Register" class="landing-text-link">Create your account <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            }
        </div>
        <div class="landing-hero-stats" aria-label="Residence availability summary">
            <div><strong>@Model.TotalAccommodations</strong><span>residences listed</span></div>
            <div><strong>@Model.TotalUnits</strong><span>managed units</span></div>
            <div><strong>24/7</strong><span>account access</span></div>
        </div>
    </div>
    <div class="landing-hero-note"><span>01</span><span class="landing-hero-note-line"></span><span>Residence, made clearer</span></div>
</section>

<section class="landing-search-panel" aria-label="Find accommodation">
    <div class="landing-search-heading">
        <span class="eyebrow">Start with what matters</span>
        <h2>Where would you like to live?</h2>
    </div>
    <form asp-controller="Accommodation" asp-action="Index" method="get" class="landing-search-form">
        <div class="landing-search-field landing-search-field-wide">
            <label for="residence-search"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Residence or area</label>
            <input id="residence-search" name="search" placeholder="Search a residence, campus area, or address" />
        </div>
        <div class="landing-search-field">
            <label for="move-in"><i class="fa-regular fa-calendar" aria-hidden="true"></i> Expected move-in</label>
            <input id="move-in" type="date" name="moveIn" />
        </div>
        <div class="landing-search-field">
            <label for="unit-type"><i class="fa-solid fa-door-open" aria-hidden="true"></i> Unit type</label>
            <select id="unit-type" name="unitType"><option value="">Any unit type</option><option value="Single">Single</option><option value="Shared">Shared</option></select>
        </div>
        <button class="btn btn-primary landing-search-submit" type="submit"><span>Find accommodation</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
    </form>
</section>

<section id="residences" class="landing-section landing-residences">
    <div class="landing-section-heading">
        <div>
            <span class="eyebrow">A place to begin</span>
            <h2>Residences with room<br /><em>for what comes next.</em></h2>
        </div>
        <div class="landing-section-intro">
            <p>Explore the homes managed by Bricks &amp; Books and find the setting that fits your next chapter at the University of the Free State.</p>
            <a asp-controller="Accommodation" asp-action="Index" class="underlined-link">View all residences <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </div>
    </div>

    <div class="residence-grid">
        @if (Model.FeaturedAccommodations.Any())
        {
            var residenceIndex = 0;
            @foreach (var accommodation in Model.FeaturedAccommodations)
            {
                var cover = accommodation.ImageUrls?.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).FirstOrDefault();
                var coverImage = string.IsNullOrWhiteSpace(cover) ? fallbackImage : Url.Content(cover);
                var description = string.IsNullOrWhiteSpace(accommodation.Description) ? "Explore unit types, amenities, and application details." : accommodation.Description;
                <article class="residence-card residence-card-@(residenceIndex % 3)" style="--card-index: @residenceIndex">
                    <a asp-controller="Accommodation" asp-action="Details" asp-route-id="@accommodation.Id" class="residence-card-image-link">
                        <div class="residence-card-image"><img src="@coverImage" alt="Residence photo for @accommodation.Name" loading="lazy" onerror="this.onerror=null;this.src='@fallbackImage';" /></div>
                        <span class="residence-card-arrow" aria-hidden="true"><i class="fa-solid fa-arrow-up-right"></i></span>
                    </a>
                    <div class="residence-card-body">
                        <div class="residence-card-meta"><span>Residence @((residenceIndex + 1).ToString("D2"))</span><span>@accommodation.Units.Count unit@(accommodation.Units.Count == 1 ? string.Empty : "s")</span></div>
                        <h3><a asp-controller="Accommodation" asp-action="Details" asp-route-id="@accommodation.Id">@accommodation.Name</a></h3>
                        <p class="residence-card-location"><i class="fa-solid fa-location-dot" aria-hidden="true"></i>@accommodation.Address</p>
                        <p class="residence-card-description">@description</p>
                    </div>
                </article>
                residenceIndex++;
            }
        }
        else
        {
            <div class="landing-empty-state"><i class="fa-solid fa-building-circle-exclamation" aria-hidden="true"></i><div><h3>New residences are on the way.</h3><p>The accommodation team has not published a listing yet. Please contact the residence office for assistance.</p></div></div>
        }
    </div>
</section>

<section class="landing-process-section">
    <div class="landing-process-intro"><span class="eyebrow">The Bricks &amp; Books way</span><h2>Everything you need,<br /><em>in one calm place.</em></h2><p>From your first search to the small details of daily residence life, your journey stays easy to follow.</p></div>
    <div class="landing-process-list">
        <div class="landing-process-item"><span class="landing-process-number">01</span><span class="landing-process-icon"><i class="fa-solid fa-compass" aria-hidden="true"></i></span><div><h3>Discover</h3><p>Compare residences, locations, and unit options before you decide.</p></div></div>
        <div class="landing-process-item"><span class="landing-process-number">02</span><span class="landing-process-icon"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></span><div><h3>Apply</h3><p>Send one clear accommodation request and follow its progress.</p></div></div>
        <div class="landing-process-item"><span class="landing-process-number">03</span><span class="landing-process-icon"><i class="fa-solid fa-house-circle-check" aria-hidden="true"></i></span><div><h3>Settle in</h3><p>Manage bills, maintenance, messages, and your residence account.</p></div></div>
    </div>
</section>

<section class="landing-cta">
    <div class="landing-cta-copy"><span class="landing-kicker landing-kicker-dark"><span class="landing-kicker-mark"></span> Your next chapter starts here</span><h2>Ready to find<br /><em>your residence?</em></h2></div>
    <div class="landing-cta-action">
        <p>Take the first step toward a residence experience that feels considered from day one.</p>
        @if (!(User.Identity?.IsAuthenticated ?? false))
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-saffron">Create an account <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        }
        else
        {
            <a asp-controller="AccommodationApplication" asp-action="Apply" class="btn btn-saffron">Open an application <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        }
    </div>
</section>

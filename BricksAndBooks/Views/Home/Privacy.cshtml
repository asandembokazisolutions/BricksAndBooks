@{
    ViewData["Title"] = "Privacy and account data";
    ViewData["MetaDescription"] = "How Bricks & Books uses account, accommodation, billing, and support information to operate the residence management service.";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="mb-4">
            <span class="eyebrow">Bricks &amp; Books</span>
            <h1 class="mt-2 mb-2">Privacy and account data</h1>
            <p class="text-muted mb-0">This page explains the information used to operate accommodation applications, residence accounts, billing, payments, maintenance requests, and support messages.</p>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <section class="mb-4">
                    <h2 class="h5">Information used by the service</h2>
                    <p class="text-muted mb-0">Bricks &amp; Books stores the details you provide for your account, including your personal contact/recovery email, name, student or employee number, generated app login address, residence application information, assigned unit, bills, payment submissions, maintenance requests, and messages. Generated addresses are app login identifiers; this service does not create or activate UFS mailboxes. This information is used to operate the accommodation service and keep a record of activity on your account.</p>
                </section>
                <section class="mb-4">
                    <h2 class="h5">Who can see it</h2>
                    <p class="text-muted mb-0">You can view your own account information, accommodation requests, bills, and support activity. Authorised administrators and financial officers can access the records required to process accommodation, manage customer accounts, review payments, update maintenance requests, and generate operational reports.</p>
                </section>
                <section class="mb-4">
                    <h2 class="h5">Attachments and messages</h2>
                    <p class="text-muted mb-0">Files added to a maintenance request are stored with that request so the responsible team can assess the issue. Do not upload identity documents, bank card details, passwords, or other information that is not needed to explain the maintenance problem.</p>
                </section>
                <section class="mb-0">
                    <h2 class="h5">Questions about your account</h2>
                    <p class="text-muted mb-0">If you need help with account information or believe a record is incorrect, contact the residence support team through the Messages area of Bricks &amp; Books.</p>
                </section>
            </div>
        </div>
    </div>
</div>

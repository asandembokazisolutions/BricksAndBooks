@{ ViewData["Title"] = "Help and support"; }
<div class="mb-4"><span class="eyebrow">Resident support</span><h2 class="mb-1">Help and support</h2><p class="text-muted mb-0">Quick answers and important information for managing your accommodation account.</p></div>
<div class="row g-4"><div class="col-lg-8"><div class="accordion" id="supportAccordion"><div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button" data-bs-toggle="collapse" data-bs-target="#faq1">How do I apply for accommodation?</button></h2><div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#supportAccordion"><div class="accordion-body">Open Accommodation, choose a residence, complete the application, and attach any required supporting documents. You can follow progress from My applications.</div></div></div><div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#faq2">How do I pay my residence bill?</button></h2><div id="faq2" class="accordion-collapse collapse" data-bs-parent="#supportAccordion"><div class="accordion-body">Open My bills, select the charges you want to submit, choose a payment method, and attach proof of payment if required. Your payment remains pending until finance verifies it.</div></div></div><div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#faq3">What are the residence rules?</button></h2><div id="faq3" class="accordion-collapse collapse" data-bs-parent="#supportAccordion"><div class="accordion-body">Residents must respect quiet hours, keep shared spaces clean, report damage promptly, follow visitor procedures, and use accommodation only for its intended purpose.</div></div></div><div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#faq4">How do I report maintenance?</button></h2><div id="faq4" class="accordion-collapse collapse" data-bs-parent="#supportAccordion"><div class="accordion-body">Open Maintenance, choose Report an issue, describe the problem, select your allocated unit, and attach photos or documents that help the team assess the issue.</div></div></div></div></div><div class="col-lg-4"><div class="card h-100"><div class="card-body"><span class="eyebrow">Contact desk</span><h3 class="h5 mt-2">Need personal assistance?</h3><p class="text-muted">Our residence support team can help with applications, billing, and maintenance.</p><div class="d-grid gap-2 small"><div><i class="fa-solid fa-envelope text-primary me-2"></i>support@bricksandbooks.example</div><div><i class="fa-solid fa-phone text-primary me-2"></i>+27 51 401 0000</div><div><i class="fa-solid fa-clock text-primary me-2"></i>Monday–Friday, 08:00–16:30</div></div><a asp-controller="Chat" asp-action="Create" class="btn btn-primary w-100 mt-4">Contact support</a></div></div></div></div>

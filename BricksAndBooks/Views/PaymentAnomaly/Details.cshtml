@model BricksAndBooks.Models.Payment

@{
    ViewData["Title"] = "Payment Anomaly Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Payment Anomaly Details</h2>

<div>
    <h4>Payment</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Amount)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Amount)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Method)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Method)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TransactionReferenceId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TransactionReferenceId)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PaymentDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PaymentDate)
        </dd>
    </dl>
</div>

<div>
    <h4>Anomaly Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Anomaly Type:
        </dt>
        <dd class="col-sm-10">
            @ViewBag.AnomalyType
        </dd>
        <dt class="col-sm-2">
            Description:
        </dt>
        <dd class="col-sm-10">
            @ViewBag.Description
        </dd>
        <dt class="col-sm-2">
            Severity:
        </dt>
        <dd class="col-sm-10">
            <span class="badge @(ViewBag.Severity == "High" ? "bg-danger" : ViewBag.Severity == "Medium" ? "bg-warning" : "bg-info")">
                @ViewBag.Severity
            </span>
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
@model BricksAndBooks.Models.ApplicationUser
@{
    ViewData["Title"] = "Edit user";
    var isStudent = Model.IsStudent;
    var isStaff = Model.IsStaff;
    var accountType = isStudent ? "Student" : isStaff ? "Staff" : "Legacy account";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div><h2 class="mb-1">Edit user</h2><p class="text-muted mb-0">The account type is already known, so only the relevant identification field is shown.</p></div>
            <a asp-action="Index" class="btn btn-light">Back to users</a>
        </div>
        <div class="card shadow-sm"><div class="card-body p-4 p-lg-5">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <div class="alert alert-light border d-flex justify-content-between align-items-center"><span><strong>Account type:</strong> @accountType</span><span class="small text-muted">Account type cannot be changed here.</span></div>

                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="Email" class="form-label">University email</label><input asp-for="Email" type="email" class="form-control" /><div class="form-text">Only addresses ending in @@ufs.ac.za are accepted.</div><span asp-validation-for="Email" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="UserName" class="form-label">Sign-in username</label><input asp-for="UserName" class="form-control" /><span asp-validation-for="UserName" class="text-danger"></span></div>
                    @if (isStudent)
                    {
                        <div class="col-md-6"><label asp-for="StudentNumber" class="form-label"></label><input asp-for="StudentNumber" class="form-control" /><div class="form-text">Required for this Student account.</div><span asp-validation-for="StudentNumber" class="text-danger"></span></div>
                    }
                    else if (isStaff)
                    {
                        <div class="col-md-6"><label asp-for="EmployeeNumber" class="form-label"></label><input asp-for="EmployeeNumber" class="form-control" /><div class="form-text">Required for this Staff account.</div><span asp-validation-for="EmployeeNumber" class="text-danger"></span></div>
                    }
                </div>

                @if (ViewData["CanManageRoles"] is bool canManageRoles && canManageRoles)
                {
                    <hr class="my-4" />
                    <h3 class="h6">Additional system access</h3>
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" asp-for="IsFinancialOfficer" /><label class="form-check-label" asp-for="IsFinancialOfficer">Financial Officer — can verify payments</label></div>
                    <div class="form-check mb-4"><input class="form-check-input" type="checkbox" asp-for="IsAdmin" /><label class="form-check-label" asp-for="IsAdmin">Administrator</label></div>
                }
                else
                {
                    <input asp-for="IsFinancialOfficer" type="hidden" />
                    <input asp-for="IsAdmin" type="hidden" />
                }
                <button type="submit" class="btn btn-primary">Save changes</button>
            </form>
        </div></div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

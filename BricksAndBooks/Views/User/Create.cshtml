@model BricksAndBooks.Models.ApplicationUser
@{
    ViewData["Title"] = "Add user";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div><h2 class="mb-1">Add user</h2><p class="text-muted mb-0">Choose one account type. The form shows only the identifier required for that type.</p></div>
            <a asp-action="Index" class="btn btn-light">Back to users</a>
        </div>
        <div class="card shadow-sm"><div class="card-body p-4 p-lg-5">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Account type</label>
                    <div class="row g-3">
                        <div class="col-md-6"><div class="border rounded p-3 h-100"><div class="form-check"><input type="radio" id="studentChoice" name="userType" value="student" class="form-check-input" @((Model?.IsStudent ?? false) ? "checked" : "") /><label class="form-check-label fw-semibold" for="studentChoice">Student</label></div><small class="text-muted">Requires a student number.</small></div></div>
                        <div class="col-md-6"><div class="border rounded p-3 h-100"><div class="form-check"><input type="radio" id="staffChoice" name="userType" value="staff" class="form-check-input" @((Model?.IsStaff ?? false) ? "checked" : "") /><label class="form-check-label fw-semibold" for="staffChoice">Staff</label></div><small class="text-muted">Requires an employee number.</small></div></div>
                    </div>
                    <input asp-for="IsStudent" type="hidden" id="IsStudent" />
                    <input asp-for="IsStaff" type="hidden" id="IsStaff" />
                </div>

                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="Email" class="form-label">University email</label><input asp-for="Email" type="email" class="form-control" placeholder="name@ufs.ac.za" /><div class="form-text">Only addresses ending in @@ufs.ac.za are accepted.</div><span asp-validation-for="Email" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="UserName" class="form-label">Sign-in username</label><input asp-for="UserName" class="form-control" placeholder="Leave blank to use the email address" /><span asp-validation-for="UserName" class="text-danger"></span></div>
                    <div class="col-md-6" id="studentIdPanel" style="display:@((Model?.IsStudent ?? false) ? "block" : "none")"><label asp-for="StudentNumber" class="form-label"></label><input asp-for="StudentNumber" class="form-control" /><span asp-validation-for="StudentNumber" class="text-danger"></span></div>
                    <div class="col-md-6" id="staffIdPanel" style="display:@((Model?.IsStaff ?? false) ? "block" : "none")"><label asp-for="EmployeeNumber" class="form-label"></label><input asp-for="EmployeeNumber" class="form-control" /><span asp-validation-for="EmployeeNumber" class="text-danger"></span></div>
                    <div class="col-md-6"><label for="Password" class="form-label">Password</label><input id="Password" name="Password" class="form-control" type="password" required /></div>
                    <div class="col-md-6"><label for="ConfirmPassword" class="form-label">Confirm password</label><input id="ConfirmPassword" name="ConfirmPassword" class="form-control" type="password" required /></div>
                </div>

                @if (ViewData["CanManageRoles"] is bool canManageRoles && canManageRoles)
                {
                    <hr class="my-4" />
                    <h3 class="h6">Additional system access</h3>
                    <p class="text-muted small">Only Administrators can assign Financial Officer and Administrator permissions.</p>
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" asp-for="IsFinancialOfficer" /><label class="form-check-label" asp-for="IsFinancialOfficer">Financial Officer — can verify payments</label></div>
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" asp-for="IsAdmin" /><label class="form-check-label" asp-for="IsAdmin">Administrator</label></div>
                    <div class="form-check mb-4"><input class="form-check-input" type="checkbox" asp-for="IsMaintenanceWorker" /><label class="form-check-label" asp-for="IsMaintenanceWorker">Maintenance worker — can be assigned to residence tasks</label></div>
                }
                <button type="submit" class="btn btn-primary">Create user</button>
            </form>
        </div></div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (() => {
            const studentChoice = document.getElementById('studentChoice');
            const staffChoice = document.getElementById('staffChoice');
            const studentFlag = document.getElementById('IsStudent');
            const staffFlag = document.getElementById('IsStaff');
            const studentPanel = document.getElementById('studentIdPanel');
            const staffPanel = document.getElementById('staffIdPanel');
            const studentInput = document.getElementById('StudentNumber');
            const staffInput = document.getElementById('EmployeeNumber');
            const setType = type => {
                const isStudent = type === 'student';
                studentFlag.value = isStudent ? 'true' : 'false';
                staffFlag.value = isStudent ? 'false' : 'true';
                studentPanel.style.display = isStudent ? 'block' : 'none';
                staffPanel.style.display = isStudent ? 'none' : 'block';
                studentInput.disabled = !isStudent;
                staffInput.disabled = isStudent;
                if (isStudent) staffInput.value = '';
                else studentInput.value = '';
            };
            studentChoice.addEventListener('change', () => setType('student'));
            staffChoice.addEventListener('change', () => setType('staff'));
            if (studentChoice.checked) setType('student');
            else if (staffChoice.checked) setType('staff');
            else { studentInput.disabled = true; staffInput.disabled = true; }
        })();
    </script>
}

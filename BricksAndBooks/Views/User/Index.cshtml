@model IEnumerable<BricksAndBooks.Models.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h2 class="mb-1">User Management</h2>
        <p class="text-muted mb-0">Manage customer accounts and use the Actions menu to view, update, reset a password, or remove an account.</p>
    </div>
    <a asp-action="Create" class="btn btn-success"><i class="fa-solid fa-user-plus me-2"></i>Create new user</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-3">User</th>
                    <th>Account type</th>
                    <th>University reference</th>
                    <th>Access</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var firstName = item.FirstName?.Trim() ?? string.Empty;
                var lastName = item.LastName?.Trim() ?? string.Empty;
                var initials = string.Concat(
                    firstName.Length > 0 ? firstName[0].ToString() : string.Empty,
                    lastName.Length > 0 ? lastName[0].ToString() : string.Empty).ToUpperInvariant();
                if (string.IsNullOrWhiteSpace(initials))
                {
                    var fallback = (item.Email ?? item.UserName ?? "U").Trim();
                    initials = fallback.Length > 0 ? fallback[0].ToString().ToUpperInvariant() : "U";
                }

                <tr>
                    <td class="ps-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle bg-light border text-primary fw-semibold d-inline-flex align-items-center justify-content-center" style="width: 2.25rem; height: 2.25rem;">@initials</span>
                            <div>
                                <div class="fw-semibold">@item.FirstName @item.LastName</div>
                                <div class="small text-muted">App login: @item.Email</div>
                                @if (!string.IsNullOrWhiteSpace(item.PersonalEmail))
                                {
                                    <div class="small text-muted">Contact: @item.PersonalEmail</div>
                                }
                            </div>
                        </div>
                    </td>
                    <td>
                        @if (item.IsStudent)
                        {
                            <span class="badge text-bg-primary"><i class="fa-solid fa-graduation-cap me-1"></i>Student</span>
                        }
                        else if (item.IsStaff)
                        {
                            <span class="badge text-bg-secondary"><i class="fa-solid fa-briefcase me-1"></i>Staff</span>
                        }
                        else
                        {
                            <span class="text-muted small">System account</span>
                        }
                    </td>
                    <td>
                        @if (item.IsStudent)
                        {
                            <span class="small text-muted">Student no.</span>
                            <div class="fw-semibold">@(item.StudentNumber ?? "Not recorded")</div>
                        }
                        else if (item.IsStaff)
                        {
                            <span class="small text-muted">Employee no.</span>
                            <div class="fw-semibold">@(item.EmployeeNumber ?? "Not recorded")</div>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @if (item.IsAdmin)
                        {
                            <span class="badge text-bg-danger">Administrator</span>
                        }
                        else if (item.IsFinancialOfficer)
                        {
                            <span class="badge text-bg-info">Financial officer</span>
                        }
                        else
                        {
                            <span class="badge text-bg-light border text-dark">Customer</span>
                        }
                    </td>
                    <td class="text-end pe-3">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-ellipsis me-1"></i>Actions
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li><a asp-action="Details" asp-route-id="@item.Id" class="dropdown-item"><i class="fa-regular fa-eye me-2 text-primary"></i>View details</a></li>
                                <li><a asp-action="Edit" asp-route-id="@item.Id" class="dropdown-item"><i class="fa-solid fa-pen-to-square me-2 text-success"></i>Edit account</a></li>
                                <li><a asp-action="ResetPassword" asp-route-id="@item.Id" class="dropdown-item"><i class="fa-solid fa-key me-2 text-warning"></i>Reset password</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a asp-action="Delete" asp-route-id="@item.Id" class="dropdown-item text-danger"><i class="fa-solid fa-trash-can me-2"></i>Delete account</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-5">No user accounts are available.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

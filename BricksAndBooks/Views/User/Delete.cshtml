@model BricksAndBooks.Models.ApplicationUser
@{
    ViewData["Title"] = "Delete User";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h2 class="h5 mb-0">Delete user account</h2>
            </div>
            <div class="card-body">
                <p>Are you sure you want to permanently delete this account?</p>
                <dl class="row mb-4">
                    <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.FirstName @Model.LastName</dd>
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Username</dt><dd class="col-sm-8">@Model.UserName</dd>
                </dl>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <button type="submit" class="btn btn-danger">Delete account</button>
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

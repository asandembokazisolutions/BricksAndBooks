@model BricksAndBooks.Models.ErrorViewModel
@{
    ViewData["Title"] = "Something needs attention";
    ViewData["MetaDescription"] = "A Bricks & Books page could not be completed. Return to the accommodation overview or contact support for assistance.";
}

<div class="row justify-content-center py-5">
    <div class="col-lg-8 col-xl-7">
        <section class="card shadow-sm border-0 text-center p-4 p-md-5">
            <div class="feature-icon mx-auto mb-4"><i class="fa-solid fa-compass"></i></div>
            <span class="eyebrow">Bricks &amp; Books</span>
            <h1 class="mt-2 mb-3">We could not complete that request.</h1>
            <p class="text-muted mx-auto mb-4" style="max-width: 36rem;">The page may have moved, the request may no longer be available, or something may need another try. Return to the accommodation overview or contact the residence support team.</p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="fa-solid fa-house me-2"></i>Return to overview</a>
                <a asp-controller="Chat" asp-action="Index" class="btn btn-outline-primary"><i class="fa-regular fa-message me-2"></i>Contact support</a>
            </div>
            @if (Model?.ShowRequestId == true)
            {
                <p class="small text-muted mt-4 mb-0">Reference: <code>@Model.RequestId</code></p>
            }
        </section>
    </div>
</div>

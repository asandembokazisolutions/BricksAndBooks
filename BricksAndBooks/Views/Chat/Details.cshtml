@model BricksAndBooks.Models.ChatMessage
@{
    ViewData["Title"] = "Message";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h5 mb-1">Message</h2>
                    <p class="text-muted small mb-0">From @Model.Sender?.FirstName @Model.Sender?.LastName to @Model.Recipient?.FirstName @Model.Recipient?.LastName</p>
                </div>
                <span class="text-muted small">@Model.SentAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
            </div>
            <div class="card-body">
                <p class="mb-0" style="white-space: pre-wrap">@Model.Content</p>
            </div>
            <div class="card-footer bg-white border-0 pt-0 pb-3">
                <a asp-action="Index" class="btn btn-light">Back to messages</a>
            </div>
        </div>
    </div>
</div>

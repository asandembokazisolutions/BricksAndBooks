@model BricksAndBooks.Models.MaintenanceRequest
@using System.Collections.Generic
@using System.Linq
@{
    ViewData["Title"] = "Update Maintenance Request";
    var attachmentPaths = (Model.AttachmentUrls ?? string.Empty)
        .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
    var isAssignedWorker = ViewBag.IsAssignedWorker is bool assignedWorker && assignedWorker;
    var assigneeCount = ViewBag.AssigneeCount is int count ? count : 0;
}
<div class="maintenance-page-heading">
    <div>
        <span class="maintenance-eyebrow">RESIDENCE SERVICES <span>/</span> WORK ORDERS</span>
        <h1>Update maintenance request</h1>
        <p>Review the issue and get it to the right person to fix it.</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light"><i class="fa-regular fa-eye me-2"></i>View request</a>
</div>
<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="maintenance-edit-grid">
        <section class="maintenance-panel request-panel">
            <header class="panel-heading"><span class="panel-icon"><i class="fa-solid fa-screwdriver-wrench"></i></span><div><h2>Request details</h2><p>Information supplied by the resident</p></div><span class="request-number">#@Model.Id</span></header>
            <div class="request-body">
                <div class="request-info"><span>Reported unit</span><strong>@ViewBag.UnitLabel</strong></div>
                <div class="request-info"><span>Trade needed</span><strong class="trade-badge"><i class="fa-solid fa-toolbox"></i>@Model.Category</strong></div>
                <div class="request-description"><span>Problem reported</span><p>@Model.Description</p></div>
            </div>
        </section>
        <section class="maintenance-panel assignment-panel">
            <header class="panel-heading"><span class="panel-icon teal"><i class="fa-solid fa-user-gear"></i></span><div><h2>Get the right specialist</h2><p>Only @Model.Category specialists can be assigned</p></div></header>
            <div class="assignment-body">
                <label asp-for="Status" class="field-label">Request status</label>
                <select asp-for="Status" class="form-select status-select" asp-items="Html.GetEnumSelectList<BricksAndBooks.Models.MaintenanceStatus>()"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
                @if (isAssignedWorker)
                {
                    <div class="current-specialist"><span class="current-specialist-icon"><i class="fa-solid fa-user-check"></i></span><div><small>THIS TASK IS ASSIGNED TO YOU</small><strong>@Model.AssignedToUser?.FirstName @Model.AssignedToUser?.LastName</strong><span>@Model.Category specialist</span></div></div>
                }
                else
                {
                    <label asp-for="AssignedToUserId" class="field-label specialist-label">Assign to specialist</label>
                    @if (assigneeCount > 0)
                    {
                        <select asp-for="AssignedToUserId" class="form-select specialist-select" asp-items="ViewBag.Assignees"></select>
                        <span asp-validation-for="AssignedToUserId" class="text-danger"></span>
                        <p class="field-hint"><i class="fa-solid fa-filter-circle-check"></i> Showing only workers trained for <strong>@Model.Category</strong>.</p>
                    }
                    else
                    {
                        <div class="no-specialist-alert"><i class="fa-solid fa-circle-info"></i><span>No @Model.Category specialist is available right now. Specialist accounts are provisioned by the residence system; please contact an administrator.</span></div>
                    }
                }
            </div>
        </section>
        <section class="maintenance-panel attachments-panel">
            <header class="panel-heading"><span class="panel-icon muted"><i class="fa-solid fa-paperclip"></i></span><div><h2>Attachments</h2><p>Share photos or documents that help explain the repair</p></div></header>
            <div class="attachments-body">
                @if (attachmentPaths.Any())
                {
                    <div class="existing-attachments">
                        <span class="field-label">Already attached</span>
                        <div class="attachment-links">
                            @for (var index = 0; index < attachmentPaths.Count; index++)
                            {
                                <a href="@attachmentPaths[index]" target="_blank" rel="noopener" class="attachment-link"><i class="fa-solid fa-file-arrow-up"></i> Attachment @(index + 1)</a>
                            }
                        </div>
                    </div>
                }
                <label for="attachments" class="field-label">Add files <span class="optional-label">(optional)</span></label>
                <input id="attachments" name="attachments" type="file" class="form-control" multiple accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx" />
                <div class="field-hint">Up to five files, 5 MB each. JPG, PNG, WEBP, PDF, DOC or DOCX.</div>
                <div class="text-danger">@Html.ValidationMessage("attachments")</div>
            </div>
        </section>
    </div>
    <div class="maintenance-save-row">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">Cancel</a>
        <button type="submit" class="maintenance-save-button"><i class="fa-solid fa-floppy-disk"></i> Save request</button>
    </div>
</form>
<style>
.maintenance-page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin:5px 0 23px}.maintenance-eyebrow{display:flex;align-items:center;gap:8px;color:#087d7a;font-size:.65rem;font-weight:850;letter-spacing:.14em}.maintenance-eyebrow span{color:#a5b4ba}.maintenance-page-heading h1{margin:8px 0 5px;color:#12394d;font-size:clamp(1.65rem,2.5vw,2.2rem);font-weight:780;letter-spacing:-.035em}.maintenance-page-heading p{margin:0;color:#657982;font-size:.9rem}.maintenance-edit-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(300px,.8fr);gap:17px}.maintenance-panel{overflow:hidden;border:1px solid #dce6e9;border-radius:16px;background:#fff;box-shadow:0 5px 20px #143a4b0a}.panel-heading{display:flex;align-items:center;gap:12px;padding:17px 20px;border-bottom:1px solid #e8eef0}.panel-icon{display:grid;place-items:center;width:40px;height:40px;flex:0 0 40px;border-radius:12px;background:#edf3f7;color:#21506b}.panel-icon.teal{background:#e9f5f2;color:#117b77}.panel-icon.muted{background:#f0f3f4;color:#647982}.panel-heading h2{margin:0;color:#17394c;font-size:1rem;font-weight:780}.panel-heading p{margin:3px 0 0;color:#75858b;font-size:.74rem}.request-number{margin-left:auto;color:#7a8c92;font-size:.75rem;font-weight:750}.request-body{padding:19px 22px 22px}.request-info{display:grid;grid-template-columns:125px 1fr;gap:12px;padding:0 0 14px;margin-bottom:14px;border-bottom:1px solid #edf1f2}.request-info>span,.request-description>span{color:#73848a;font-size:.73rem;font-weight:700}.request-info>strong{color:#1c3d4d;font-size:.86rem}.trade-badge{display:inline-flex;align-items:center;gap:7px;width:max-content;padding:6px 9px;border:1px solid #d7eae6;border-radius:7px;background:#f0f8f6;color:#14736e!important;font-size:.75rem!important}.request-description p{margin:7px 0 0;color:#253f4c;font-size:.95rem;line-height:1.65;white-space:pre-line}.assignment-body{padding:18px 20px 21px}.field-label{display:block;margin:0 0 7px;color:#254556
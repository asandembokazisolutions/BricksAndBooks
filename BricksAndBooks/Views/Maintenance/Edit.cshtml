r;gap:9px;padding:11px 17px;border:0;border-radius:9px;background:#0b7180;color:#fff;font-size:.82rem;font-weight:750;transition:background .18s,transform .18s}.maintenance-save-button:hover,.create-specialist-button:hover{background:#095b68;color:#fff;transform:translateY(-1px)}.create-specialist-panel{margin:8px 0 30px;padding:22px 24px 0;border:1px solid #d3e5e3;border-radius:17px;background:linear-gradient(135deg,#f7fbfa,#fff 64%);box-shadow:0 9px 27px #0e57530b}.create-specialist-intro{display:flex;align-items:flex-start;gap:14px;max-width:760px;margin-bottom:21px}.create-worker-icon{display:grid;place-items:center;width:46px;height:46px;flex:0 0 46px;border-radius:14px;background:#e3f3ef;color:#0d8076;font-size:1.05rem}.create-specialist-intro h2{margin:5px 0 5px;color:#123d4c;font-size:1.24rem;font-weight:780;letter-spacing:-.025em}.create-specialist-intro p{margin:0;color:#667d83;font-size:.8rem;line-height:1.55}.worker-error-list{font-size:.8rem}.specialist-create-form{border-top:1px solid #e3eceb}.specialist-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px;padding:19px 0}.specialist-field label{display:block;margin-bottom:6px;color:#36515c;font-size:.71rem;font-weight:750}.specialist-field .form-control{min-height:42px;border-color:#d9e5e7;border-radius:8px;font-size:.82rem;box-shadow:none}.fixed-specialty{display:flex;align-items:center;gap:8px;min-height:42px;padding:0 11px;border:1px solid #d9e8e3;border-radius:8px;background:#f0f8f5;color:#197569}.fixed-specialty i{font-size:.76rem}.fixed-specialty strong{font-size:.8rem}.fixed-specialty span{margin-left:auto;color:#6e8982;font-size:.64rem}.create-specialist-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0 17px;border-top:1px solid #e3eceb}.create-specialist-footer>span{display:flex;align-items:center;gap:7px;color:#618076;font-size:.71rem}.create-specialist-footer>span i{color:#2b9a72}.create-specialist-button{padding:10px 14px;background:#0f7569}@@media(max-width:800px){.maintenance-edit-grid{grid-template-columns:1fr}.attachments-panel{grid-column:auto}.specialist-fields{grid-template-columns:repeat(2,minmax(0,1fr))}}@@media(max-width:560px){.maintenance-page-heading{align-items:flex-start;flex-direction:column}.maintenance-page-heading>.btn{width:100%}.panel-heading{padding:15px}.request-body,.assignment-body,.attachments-body{padding:16px}.request-info{grid-template-columns:95px 1fr}.create-specialist-panel{padding:17px 15px 0}.specialist-fields{grid-template-columns:1fr;gap:12px}.create-specialist-footer{align-items:stretch;flex-direction:column}.create-specialist-button{width:100%}}
</style>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

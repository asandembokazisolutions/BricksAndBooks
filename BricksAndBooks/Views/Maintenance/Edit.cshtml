@model BricksAndBooks.Models.MaintenanceRequest
@{
    ViewData["Title"] = "Edit Maintenance Request";
    var attachmentPaths = (Model.AttachmentUrls ?? string.Empty)
        .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h2 class="mb-1">Update Maintenance Request</h2>
        <p class="text-muted mb-0">Update the request status, assign a responsible team member, or add supporting files.</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light"><i class="fa-regular fa-eye me-2"></i>View request</a>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white"><strong>Request details</strong></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Reported unit</dt>
                        <dd class="col-sm-8 fw-semibold">@ViewBag.UnitLabel</dd>
                        <dt class="col-sm-4 text-muted">Category</dt>
                        <dd class="col-sm-8"><span class="badge text-bg-light border text-dark">@Model.Category</span></dd>
                        <dt class="col-sm-4 text-muted">Description</dt>
                        <dd class="col-sm-8 mb-0" style="white-space: pre-line;">@Model.Description</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white"><strong>Assignment and status</strong></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<BricksAndBooks.Models.MaintenanceStatus>()"></select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="AssignedToUserId" class="form-label fw-semibold">Assign to</label>
                        <select asp-for="AssignedToUserId" class="form-select" asp-items="ViewBag.Assignees"></select>
                        <div class="form-text">Select an administrator or financial officer, or leave the request unassigned.</div>
                        <span asp-validation-for="AssignedToUserId" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white"><strong>Attachments</strong></div>
                <div class="card-body">
                    @if (attachmentPaths.Any())
                    {
                        <div class="mb-3">
                            <div class="small text-muted mb-2">Files already attached</div>
                            <div class="d-flex flex-wrap gap-2">
                                @for (var index = 0; index < attachmentPaths.Count; index++)
                                {
                                    <a href="@attachmentPaths[index]" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">
                                        <i class="fa-solid fa-paperclip me-1"></i>Attachment @(index + 1)
                                    </a>
                                }
                            </div>
                        </div>
                    }
                    <label for="attachments" class="form-label fw-semibold">Add files <span class="text-muted fw-normal">(optional)</span></label>
                    <input id="attachments" name="attachments" type="file" class="form-control" multiple accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx" />
                    <div class="form-text">Choose up to five new files. Supported files: JPG, JPEG, PNG, WEBP, PDF, DOC, and DOCX. Maximum 5 MB each.</div>
                    <div class="text-danger">@Html.ValidationMessage("attachments")</div>
                </div>
                <div class="card-footer bg-white d-flex justify-content-end gap-2">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-2"></i>Save changes</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model IEnumerable<BricksAndBooks.Models.MaintenanceRequest>
@using BricksAndBooks.Models
@{ ViewData["Title"] = "Maintenance requests"; var requests = Model.ToList();
   string RelativeTime(DateTime value) { var minutes = Math.Max(0, (int)(DateTime.UtcNow - value.ToUniversalTime()).TotalMinutes); return minutes < 1 ? "Updated just now" : minutes < 60 ? $"Updated {minutes} minute(s) ago" : minutes < 1440 ? $"Updated {minutes / 60} hour(s) ago" : $"Updated {minutes / 1440} day(s) ago"; }
   int Progress(MaintenanceStatus status) => status switch { MaintenanceStatus.Submitted => 20, MaintenanceStatus.UnderReview => 40, MaintenanceStatus.Assigned => 60, MaintenanceStatus.InProgress => 80, MaintenanceStatus.Resolved or MaintenanceStatus.Closed => 100, _ => 20 }; }
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><span class="eyebrow">Residence support</span><h2 class="mb-1">Maintenance requests</h2><p class="text-muted mb-0">Report a problem, attach photos, and follow its progress to resolution.</p></div>@if ((User.IsInRole("Student") || User.IsInRole("Staff")) && !User.IsInRole("Admin") && !User.IsInRole("FinancialOfficer")) { <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-wrench me-2"></i>Report an issue</a> }</div>
@if (!requests.Any()) { <div class="card text-center p-5"><span class="empty-icon mx-auto mb-3"><i class="fa-solid fa-screwdriver-wrench"></i></span><h3 class="h5">No maintenance requests</h3><p class="text-muted mb-3">You have no active maintenance requests. If something needs attention, report it here.</p>@if (User.IsInRole("Student") || User.IsInRole("Staff")) { <a asp-action="Create" class="btn btn-outline-primary">Report an issue</a> }</div> }
else { <div class="row g-3">@foreach (var item in requests) { var statusClass = item.Status is MaintenanceStatus.Resolved or MaintenanceStatus.Closed ? "bg-success" : item.Status == MaintenanceStatus.InProgress ? "bg-primary" : "bg-warning"; <div class="col-lg-6"><article class="card h-100"><div class="card-body"><div class="d-flex justify-content-between gap-3"><div><span class="eyebrow">Request #@item.Id</span><h3 class="h5 mt-1 mb-1">@item.Category</h3></div><span class="badge @statusClass">@item.Status</span></div><p class="mb-2">@item.Description</p><div class="small text-muted mb-3"><i class="fa-solid fa-house me-1"></i>Unit @item.Unit?.UnitNumber · @RelativeTime(item.UpdatedAt ?? item.SubmittedAt)</div><div class="d-flex justify-content-between small text-muted mb-1"><span>Submitted</span><span>Review</span><span>Assigned</span><span>Resolved</span></div><div class="progress mb-3" style="height:8px"><div class="progress-bar @(item.Status is MaintenanceStatus.Resolved or MaintenanceStatus.Closed ? "bg-success" : "bg-primary")" style="width:@Progress(item.Status)%"></div></div>@if (!string.IsNullOrWhiteSpace(item.AttachmentUrls)) { <div class="small text-muted mb-3"><i class="fa-solid fa-paperclip me-1"></i>Photo/document attachments included</div> }<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View request</a></div></article></div> }</div> }

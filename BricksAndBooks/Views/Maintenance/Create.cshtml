@model BricksAndBooks.Models.MaintenanceRequest
@{
    ViewData["Title"] = "Create Maintenance Request";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h2 class="mb-1">Create Maintenance Request</h2>
        <p class="text-muted mb-0">Tell us what is wrong, select your allocated unit, and attach photos or documents if they will help the maintenance team.</p>
    </div>
    <a asp-action="Index" class="btn btn-light"><i class="fa-solid fa-arrow-left me-2"></i>Back to requests</a>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="UnitId" class="form-label fw-semibold">Allocated unit</label>
                    <select asp-for="UnitId" class="form-select" asp-items="ViewBag.Units">
                        <option value="">Select your unit</option>
                    </select>
                    <span asp-validation-for="UnitId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Category" class="form-label fw-semibold"></label>
                    <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<BricksAndBooks.Models.MaintenanceCategory>()"></select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="5" maxlength="2000" placeholder="Describe the issue, where it is located, and anything the team should know."></textarea>
                    <div class="form-text">Maximum 2,000 characters.</div>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label for="attachments" class="form-label fw-semibold">Attachments <span class="text-muted fw-normal">(optional)</span></label>
                    <input id="attachments" name="attachments" type="file" class="form-control" multiple accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx" />
                    <div class="form-text">Choose up to five photos or documents. Supported files: JPG, JPEG, PNG, WEBP, PDF, DOC, and DOCX. Maximum 5 MB each.</div>
                    <div class="text-danger">@Html.ValidationMessage("attachments")</div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-light">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-paper-plane me-2"></i>Submit request</button>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model IEnumerable<BricksAndBooks.Models.Bill>
@{
    ViewData["Title"] = "My bills";
    var outstandingBills = Model.Count(bill => bill.Status != BricksAndBooks.Models.BillStatus.Paid && bill.Status != BricksAndBooks.Models.BillStatus.Cancelled);
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h2 class="mb-1">My bills</h2>
        <p class="text-muted mb-0">Review your monthly charges, then choose exactly what you want to pay in the flexible payment workspace.</p>
    </div>
    @if (outstandingBills > 0)
    {
        <a asp-action="Process" class="btn btn-primary"><i class="fa-solid fa-wallet me-2"></i>Choose items to pay</a>
    }
</div>

<div class="alert alert-light border d-flex align-items-start gap-3 mb-4" role="note">
    <i class="fa-solid fa-calendar-days text-primary mt-1"></i>
    <div>
        <strong>Monthly payment deadline.</strong> The payment window runs from the <strong>30th and 31st of the previous month</strong> through the <strong>1st of the billing month</strong>. Any unpaid balance is marked <strong>Overdue</strong> from the 2nd.
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th class="ps-3">Period</th><th>Rent</th><th>Utilities</th><th>Parking & vehicle</th><th>Total</th><th>Payment deadline</th><th>Status</th><th class="text-end pe-3"></th></tr></thead>
            <tbody>
            @foreach (var bill in Model)
            {
                <tr>
                    <td class="ps-3"><strong>@(new DateTime(bill.Year, bill.Month, 1).ToString("MMMM yyyy"))</strong></td>
                    <td>@bill.RentAmount.ToString("C")</td>
                    <td>@((bill.WaterAmount + bill.ElectricityAmount).ToString("C"))</td>
                    <td>
                        @if (bill.ParkingAmount + bill.AdditionalVehicleAmount > 0)
                        {
                            <div class="fw-semibold">@((bill.ParkingAmount + bill.AdditionalVehicleAmount).ToString("C"))</div>
                            <div class="small text-success"><i class="fa-solid fa-car me-1"></i>Payable vehicle charge</div>
                        }
                        else
                        {
                            <span class="text-muted">@((bill.ParkingAmount + bill.AdditionalVehicleAmount).ToString("C"))</span>
                        }
                    </td>
                    <td class="fw-semibold">@bill.TotalAmount.ToString("C")</td>
                    <td>
                        <div>@bill.DueDate.ToString("dd MMM yyyy")</div>
                        <div class="small text-muted">Window: @bill.PaymentWindowStart.ToString("dd MMM") – @bill.DueDate.ToString("dd MMM")</div>
                    </td>
                    <td>
                        @if (bill.Status == BricksAndBooks.Models.BillStatus.Paid)
                        {
                            <span class="badge bg-success">Paid</span>
                        }
                        else if (bill.IsOverdue)
                        {
                            <span class="badge bg-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i>Overdue</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>
                    <td class="text-end pe-3">
                        @if (bill.Status != BricksAndBooks.Models.BillStatus.Paid && bill.Status != BricksAndBooks.Models.BillStatus.Cancelled)
                        {
                            <a asp-action="Process" class="btn btn-sm btn-outline-primary">Choose charges</a>
                        }
                        else if (bill.Status == BricksAndBooks.Models.BillStatus.Paid)
                        {
                            <span class="text-muted small">Paid in full</span>
                        }
                        else
                        {
                            <span class="text-muted small">Cancelled</span>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-5">No bills are available for your account yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

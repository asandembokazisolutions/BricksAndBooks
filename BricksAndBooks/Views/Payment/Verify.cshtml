@model BricksAndBooks.Models.Payment
@{
    ViewData["Title"] = "Verify payment";
}

<h2 class="mb-1">Verify payment</h2>
<p class="text-muted mb-4">Confirm the status of this submitted transaction. Approving it updates the paid status of all fully covered bills.</p>

<form asp-action="Verify" method="post" class="row g-4">
    <input type="hidden" asp-for="Id" />
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong>Selected billing items</strong></div>
            <div class="table-responsive">
                <table class="table mb-0"><thead><tr><th class="ps-3">Period</th><th>Charge type</th><th class="text-end pe-3">Amount</th></tr></thead><tbody>
                @foreach (var allocation in Model.Allocations.OrderBy(item => item.Bill?.Year).ThenBy(item => item.Bill?.Month).ThenBy(item => item.ChargeType))
                {
                    <tr><td class="ps-3">@(allocation.Bill == null ? "Legacy bill" : new DateTime(allocation.Bill.Year, allocation.Bill.Month, 1).ToString("MMMM yyyy"))</td><td>@allocation.ChargeType</td><td class="text-end pe-3">@allocation.Amount.ToString("C")</td></tr>
                }
                @if (!Model.Allocations.Any())
                {
                    <tr><td colspan="3" class="text-muted text-center py-4">This is a legacy single-bill payment record.</td></tr>
                }
                </tbody></table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm"><div class="card-body">
            <dl class="row"><dt class="col-6">Amount</dt><dd class="col-6 text-end fw-bold">@Model.Amount.ToString("C")</dd><dt class="col-6">Method</dt><dd class="col-6 text-end">@Model.Method</dd><dt class="col-6">Reference</dt><dd class="col-6 text-end small">@Model.TransactionReferenceId</dd></dl>
            <label asp-for="Status" class="form-label fw-semibold"></label>
            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<BricksAndBooks.Models.PaymentStatus>()"></select>
            <span asp-validation-for="Status" class="text-danger"></span>
            <button type="submit" class="btn btn-primary w-100 mt-4">Save verification</button>
        </div></div>
    </div>
</form>
<div class="mt-4"><a asp-action="Index" class="btn btn-light">Back to payments</a></div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

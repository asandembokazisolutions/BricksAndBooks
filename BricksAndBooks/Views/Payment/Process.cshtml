@using BricksAndBooks.Models
@model BricksAndBooks.Models.ViewModels.FlexiblePaymentViewModel
@{
    ViewData["Title"] = "Make a payment";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h2 class="mb-1">Choose what you are paying</h2>
        <p class="text-muted mb-0">Select any combination of rent, utilities, parking, or vehicle charges. You can pay two, three, or any number of available months in one transaction. Bills are due by the 1st after the 30th–31st payment window.</p>
    </div>
    <a asp-action="MyBills" class="btn btn-light"><i class="fa-solid fa-file-invoice-dollar me-2"></i>View my bills</a>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-success shadow-sm">
        <i class="fa-solid fa-circle-check me-2"></i>There are no unpaid billing items available for your current accommodation.
    </div>
}
else
{
    <form asp-action="Process" method="post" id="flexible-payment-form">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <div><strong>Outstanding items</strong><div class="small text-muted">Each selected item is reserved while payment verification is pending.</div></div>
                        <span class="badge text-bg-primary" id="selected-count">0 selected</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th class="ps-3">Pay</th><th>Period</th><th>Charge type</th><th>Due date</th><th class="text-end pe-3">Amount</th></tr></thead>
                            <tbody>
                            @for (var i = 0; i < Model.Items.Count; i++)
                            {
                                var item = Model.Items[i];
                                var isOverdue = DateTime.UtcNow.Date > item.DueDate.Date;
                                <tr>
                                    <td class="ps-3">
                                        <input asp-for="Items[i].IsSelected" class="form-check-input payment-item" data-amount="@item.OutstandingAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                        <input asp-for="Items[i].BillId" type="hidden" />
                                        <input asp-for="Items[i].ChargeType" type="hidden" />
                                    </td>
                                    <td>
                                        <strong>@item.BillingPeriod</strong>
                                        @if (isOverdue)
                                        {
                                            <div class="small text-danger fw-semibold"><i class="fa-solid fa-triangle-exclamation me-1"></i>Overdue since @item.DueDate.AddDays(1).ToString("dd MMM")</div>
                                        }
                                        @if (item.AlreadyAllocated > 0)
                                        {
                                            <div class="small text-warning">@item.AlreadyAllocated.ToString("C") awaiting verification</div>
                                        }
                                    </td>
                                    <td><span class="badge text-bg-light border text-dark">@item.ChargeLabel</span></td>
                                    <td><div>@item.DueDate.ToString("dd MMM yyyy")</div><div class="small text-muted">Due by 1st</div></td>
                                    <td class="text-end pe-3 fw-semibold">@item.OutstandingAmount.ToString("C")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm position-sticky" style="top: 1rem;">
                    <div class="card-header bg-white"><strong>Payment summary</strong></div>
                    <div class="card-body">
                        <label asp-for="Method" class="form-label fw-semibold"></label>
                        <select asp-for="Method" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select mb-4"></select>
                        <div class="d-flex justify-content-between text-muted small mb-1"><span>Selected billing items</span><span id="selected-count-copy">0</span></div>
                        <div class="d-flex justify-content-between align-items-end border-top pt-3 mb-4"><span class="fw-semibold">Total to submit</span><strong class="fs-4" id="selected-total">R0.00</strong></div>
                        <button type="submit" class="btn btn-primary w-100" id="submit-payment"><i class="fa-solid fa-lock me-2"></i>Submit payment for verification</button>
                        <p class="small text-muted mb-0 mt-3">Your payment remains pending until an authorised financial officer verifies it. This screen records a payment request; it does not collect card details.</p>
                    </div>
                </div>
            </div>
        </div>
    </form>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (() => {
            const items = Array.from(document.querySelectorAll('.payment-item'));
            const total = document.getElementById('selected-total');
            const count = document.getElementById('selected-count');
            const countCopy = document.getElementById('selected-count-copy');
            const submit = document.getElementById('submit-payment');
            const currency = new Intl.NumberFormat('en-ZA', { style: 'currency', currency: 'ZAR' });

            const updateSummary = () => {
                const selected = items.filter(item => item.checked);
                const selectedTotal = selected.reduce((sum, item) => sum + Number(item.dataset.amount || 0), 0);
                if (total) total.textContent = currency.format(selectedTotal);
                if (count) count.textContent = `${selected.length} selected`;
                if (countCopy) countCopy.textContent = selected.length;
                if (submit) submit.disabled = selected.length === 0;
            };

            items.forEach(item => item.addEventListener('change', updateSummary));
            updateSummary();
        })();
    </script>
}

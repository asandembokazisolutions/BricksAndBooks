@model IEnumerable<BricksAndBooks.Models.AccommodationApplication>
@using BricksAndBooks.Models
@{
    ViewData["Title"] = User.IsInRole("Admin") ? "Accommodation Applications" : "My Accommodation Applications";
    string RelativeTime(DateTime value)
    {
        var minutes = Math.Max(0, (int)(DateTime.UtcNow - value.ToUniversalTime()).TotalMinutes);
        return minutes < 1 ? "Updated just now" : minutes < 60 ? $"Updated {minutes} minute(s) ago" : minutes < 1440 ? $"Updated {minutes / 60} hour(s) ago" : $"Updated {minutes / 1440} day(s) ago";
    }
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <span class="eyebrow">Accommodation workflow</span>
        <h2 class="mb-1">@ViewData["Title"]</h2>
        <p class="text-muted mb-0">Apply to as many available residences as you like. Each application is reviewed separately by an administrator.</p>
    </div>
    @if (!User.IsInRole("Admin"))
    {
        <a asp-action="Apply" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>Apply for accommodation</a>
    }
</div>

@if (TempData["ApplicationError"] != null)
{
    <div class="alert alert-danger">@TempData["ApplicationError"]</div>
}
@if (TempData["ApplicationSuccess"] != null)
{
    <div class="alert alert-success">@TempData["ApplicationSuccess"]</div>
}

@if (!Model.Any())
{
    <div class="card card-body text-center py-5"><i class="fa-regular fa-building fs-2 text-muted mb-3"></i><h4>No applications yet</h4><p class="text-muted mb-0">Submit an application when you are ready to request accommodation.</p></div>
}
else
{
    <div class="row g-3">
    @foreach (var application in Model)
    {
        var statusClass = application.Status switch
        {
            AccommodationApplicationStatus.Approved => "bg-success",
            AccommodationApplicationStatus.Denied => "bg-danger",
            AccommodationApplicationStatus.TerminationRequested => "bg-warning",
            AccommodationApplicationStatus.Terminated => "bg-secondary",
            _ => "bg-primary"
        };
        <div class="col-12">
            <div class="card card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        <h5 class="mb-1">@application.Accommodation?.Name</h5>
                        @if (User.IsInRole("Admin")) { <div class="text-muted small">Applicant: @application.User?.FirstName @application.User?.LastName (@application.User?.Email)</div> }
                        <div class="text-muted small">Submitted @application.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm") · @RelativeTime(application.ReviewedAt ?? application.CreatedAt)</div>
                    </div>
                    <span class="badge @statusClass">@application.Status</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(application.ApplicantMessage)) { <p class="mt-3 mb-2"><strong>Applicant message:</strong> @application.ApplicantMessage</p> }
                @if (application.AssignedUnit != null) { <p class="mt-3 mb-2"><strong>Assigned unit:</strong> @application.AssignedUnit.UnitNumber (@application.AssignedUnit.OccupancyType)</p> }
                @if (!string.IsNullOrWhiteSpace(application.AdminNotes)) { <p class="text-muted mb-2"><strong>Admin note:</strong> @application.AdminNotes</p> }
                <div class="application-progress mt-3 mb-3" aria-label="Application progress">
                    @{ var progress = application.Status switch { AccommodationApplicationStatus.Pending => 25, AccommodationApplicationStatus.UnderReview => 50, AccommodationApplicationStatus.Approved => 100, AccommodationApplicationStatus.Denied => 100, _ => 100 }; }
                    <div class="d-flex justify-content-between small text-muted mb-1"><span>Submitted</span><span>Review</span><span>Decision</span><span>Allocated</span></div>
                    <div class="progress" style="height:8px"><div class="progress-bar @(application.Status == AccommodationApplicationStatus.Denied ? "bg-danger" : "bg-primary")" style="width:@progress%"></div></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(application.DocumentUrls))
                {
                    <div class="small mb-2"><strong>Supporting documents:</strong> @foreach (var document in application.DocumentUrls.Split(',', StringSplitOptions.RemoveEmptyEntries)) { <a class="ms-2" href="@document" target="_blank" rel="noopener"><i class="fa-solid fa-paperclip me-1"></i>Open document</a> }</div>
                }

                @if (User.IsInRole("Admin") && application.Status == AccommodationApplicationStatus.Pending)
                {
                    <div class="border-top pt-3 mt-2">
                        <form asp-action="Approve" method="post" class="row g-2 align-items-end mb-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@application.Id" />
                            <div class="col-md-4"><label class="form-label">Assign unit</label><select name="assignedUnitId" class="form-select" required><option value="">Select available unit</option>@foreach (var unit in application.Accommodation?.Units ?? new List<Unit>()) { <option value="@unit.Id">@unit.UnitNumber — @unit.OccupancyType, capacity @unit.Capacity</option> }</select></div>
                            <div class="col-md-5"><label class="form-label">Admin note</label><input name="adminNotes" class="form-control" placeholder="Optional approval note" /></div>
                            <div class="col-md-3 d-flex gap-2"><button class="btn btn-success flex-fill" type="submit" data-confirm="Approve this application and allocate the selected unit?">Approve</button></div>
                        </form>
                        <form asp-action="Deny" method="post" class="row g-2 align-items-end">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@application.Id" />
                            <div class="col-md-9"><input name="adminNotes" class="form-control" placeholder="Reason for denial" required /></div>
                            <div class="col-md-3"><button class="btn btn-outline-danger w-100" type="submit" data-confirm="Deny this application?">Deny application</button></div>
                        </form>
                    </div>
                }
                @if (User.IsInRole("Admin") && application.Status == AccommodationApplicationStatus.TerminationRequested)
                {
                    <div class="border-top pt-3 mt-2 d-flex gap-2">
                        <form asp-action="ApproveTermination" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@application.Id" /><button class="btn btn-danger" type="submit" data-confirm="Approve this termination request?">Approve termination</button></form>
                        <form asp-action="DenyTermination" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@application.Id" /><button class="btn btn-outline-secondary" type="submit">Keep accommodation</button></form>
                    </div>
                }
                @if (!User.IsInRole("Admin") && application.Status == AccommodationApplicationStatus.Approved)
                {
                    <a asp-action="DownloadProof" class="btn btn-sm btn-primary mb-2"><i class="fa-solid fa-file-arrow-down me-1"></i>Download proof of accommodation</a>
                    <form asp-action="RequestTermination" method="post" class="border-top pt-3 mt-2 row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <div class="col-md-9"><label class="form-label">Need to leave this accommodation?</label><input name="message" class="form-control" placeholder="Optional termination reason" /></div>
                        <div class="col-md-3"><button class="btn btn-outline-danger w-100" type="submit" data-confirm="Submit a request to terminate your accommodation?">Request termination</button></div>
                    </form>
                }
            </div>
        </div>
    }
    </div>
}

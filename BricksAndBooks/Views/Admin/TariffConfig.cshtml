@model IEnumerable<BricksAndBooks.Models.Tariff>

@{
    ViewData["Title"] = "Tariff Configuration";
}

<h2>@ViewData["Title"]</h2>
<p>
    <a asp-action="TariffConfigCreate" class="btn btn-success">Add New Tariff</a>
</p>
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Type)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Amount)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Description)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EffectiveFrom)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EffectiveTo)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Type)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Amount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EffectiveFrom)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EffectiveTo)
            </td>
            <td>
                <a asp-action="TariffConfigEdit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Edit</a>
                <a asp-action="TariffConfigDelete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
        </tbody>
    </table>
</div>
@model BricksAndBooks.Models.Tariff

@{
    ViewData["Title"] = "Edit Tariff";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="TariffConfigEdit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="Type" class="control-label"></label>
                <select asp-for="Type" asp-items="Html.GetEnumSelectList<TariffType>()" class="form-control">
                    <option value="">-- Select Tariff Type --</option>
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="Amount" class="control-label">Rate per unit (R)</label>
                <div class="form-text mb-2">Water is priced per litre; electricity per kWh. Rent/parking remain monthly or per vehicle.</div>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="Description" class="control-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EffectiveFrom" class="control-label"></label>
        <input asp-for="EffectiveFrom" type="date" class="form-control" />
        <span asp-validation-for="EffectiveFrom" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EffectiveTo" class="control-label"></label>
        <input asp-for="EffectiveTo" type="date" class="form-control" />
        <span asp-validation-for="EffectiveTo" class="text-danger"></span>
        <small class="form-text text-muted">Leave blank for no end date (currently effective)</small>
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="TariffConfig" class="btn btn-light">Cancel</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
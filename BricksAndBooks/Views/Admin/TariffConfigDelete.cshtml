@model BricksAndBooks.Models.Tariff
@{
    ViewData["Title"] = "Delete Tariff";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h2 class="h5 mb-0">Delete tariff</h2>
            </div>
            <div class="card-body">
                <p>Are you sure you want to delete this tariff?</p>
                <dl class="row mb-4">
                    <dt class="col-sm-4">Type</dt><dd class="col-sm-8">@Model.Type</dd>
                    <dt class="col-sm-4">Amount</dt><dd class="col-sm-8">@Model.Amount.ToString("C")</dd>
                    <dt class="col-sm-4">Description</dt><dd class="col-sm-8">@Model.Description</dd>
                </dl>
                <form asp-action="TariffConfigDelete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Delete tariff</button>
                    <a asp-action="TariffConfig" class="btn btn-light">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

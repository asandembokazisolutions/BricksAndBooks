@model IEnumerable<BricksAndBooks.Models.Announcement>
@{ ViewData["Title"] = "Announcements"; }
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><span class="eyebrow">Residence communications</span><h2 class="mb-1">Announcements</h2><p class="text-muted mb-0">Important updates for residents and the residence community.</p></div>@if (User.IsInRole("Admin")) { <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>New announcement</a> }</div>
<div class="row g-3">@foreach (var item in Model) { <div class="col-lg-6"><article class="card h-100"><div class="card-body"><div class="d-flex justify-content-between gap-3"><span class="badge bg-primary">@item.Audience</span><small class="text-muted">@item.PublishedAt.ToLocalTime().ToString("dd MMM yyyy")</small></div><h3 class="h5 mt-3">@item.Title</h3><p class="mb-0">@item.Message</p></div></article></div>} @if (!Model.Any()) { <div class="col-12"><div class="card p-5 text-center text-muted">No announcements have been published.</div></div> }</div>

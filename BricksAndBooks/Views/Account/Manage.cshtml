@model BricksAndBooks.Models.ViewModels.ManageViewModel
@{
    ViewData["Title"] = "Manage Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Manage Account</h2>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Manage" method="post">
            <div class="form-group">
                <label asp-for="FirstName" class="control-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <div class="form-control-plaintext">@Model.Email</div>
                <div class="form-text">University email is generated from your student or staff number and cannot be changed here.</div>
            </div>
            <div class="form-group">
                <label asp-for="PhoneNumber" class="control-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <p class="text-muted small">Roles and access permissions are managed by an administrator.</p>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-controller="Home" asp-action="Index" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

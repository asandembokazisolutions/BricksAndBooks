@model BricksAndBooks.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<section class="auth-layout">
    <aside class="auth-aside">
        <div>
            <span class="eyebrow text-white-50">Bricks &amp; Books</span>
            <h2 class="mt-3 mb-3">Can't sign in?</h2>
            <p class="mb-0">Tell us your personal contact email and we'll send an administrator a request to reset your password.</p>
        </div>
        <div class="auth-steps">
            <div class="auth-step"><i class="fa-solid fa-envelope"></i><span><strong class="d-block text-white">Submit your email</strong>We'll confirm the request was received either way.</span></div>
            <div class="auth-step"><i class="fa-solid fa-user-shield"></i><span><strong class="d-block text-white">Reviewed by staff</strong>An administrator or financial officer will action it.</span></div>
            <div class="auth-step"><i class="fa-solid fa-key"></i><span><strong class="d-block text-white">New password issued</strong>You'll get a temporary password to sign in with, then you can change it.</span></div>
        </div>
    </aside>
    <div class="auth-form-panel">
        <span class="eyebrow">Secure account access</span>
        <h1 class="mt-2 mb-2">Request a password reset</h1>
        <p class="text-muted mb-4">Use the personal email address you provided when you registered.</p>
        <form asp-action="ForgotPassword" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Personal contact email</label>
                <div class="input-group"><span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-regular fa-envelope"></i></span><input asp-for="Email" class="form-control border-start-0" autocomplete="email" placeholder="you@example.com" /></div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-paper-plane me-2"></i>Send request</button>
        </form>
        <p class="auth-footer mb-0"><a asp-action="Login" class="fw-semibold text-primary"><i class="fa-solid fa-arrow-left me-1"></i>Back to sign in</a></p>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

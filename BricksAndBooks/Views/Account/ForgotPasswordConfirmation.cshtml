@{
    ViewData["Title"] = "Request sent";
}

<section class="auth-layout">
    <aside class="auth-aside">
        <div>
            <span class="eyebrow text-white-50">Bricks &amp; Books</span>
            <h2 class="mt-3 mb-3">Request received.</h2>
            <p class="mb-0">If that email matches an account, an administrator has been notified and will be in touch.</p>
        </div>
    </aside>
    <div class="auth-form-panel d-flex flex-column justify-content-center">
        <span class="eyebrow">Secure account access</span>
        <h1 class="mt-2 mb-3"><i class="fa-solid fa-circle-check text-success me-2"></i>Check with your administrator</h1>
        <p class="text-muted mb-4">
            If an account exists for the email you entered, a password reset request has been sent to our staff.
            You'll be notified once a new temporary password has been issued for you.
        </p>
        <a asp-action="Login" class="btn btn-primary"><i class="fa-solid fa-arrow-left me-2"></i>Back to sign in</a>
    </div>
</section>

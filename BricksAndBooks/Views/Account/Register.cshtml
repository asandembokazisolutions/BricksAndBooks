@model BricksAndBooks.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create your account";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card dashboard-reference-card border-0">
            <div class="card-body p-4 p-lg-5">
                <span class="eyebrow">Bricks &amp; Books access</span>
                <h1 class="h2 mt-2 mb-2">Create your account</h1>
                <p class="text-muted mb-4">Choose Student or Staff, enter the matching university number, and provide your personal email for contact and recovery. Your sign-in address is created from your number.</p>
                <form asp-action="Register" method="post" id="registrationForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger"></div>
                    <div class="mb-4">
                        <span class="form-label fw-semibold d-block">I am registering as</span>
                        <div class="registration-choice" role="radiogroup" aria-label="Choose account type">
                            <div class="position-relative">
                                <input asp-for="ApplicantType" type="radio" id="studentChoice" value="student" />
                                <label for="studentChoice"><i class="fa-solid fa-graduation-cap mb-2" aria-hidden="true"></i><strong>Student</strong><small>I need student accommodation.</small></label>
                            </div>
                            <div class="position-relative">
                                <input asp-for="ApplicantType" type="radio" id="staffChoice" value="staff" />
                                <label for="staffChoice"><i class="fa-solid fa-id-badge mb-2" aria-hidden="true"></i><strong>Staff member</strong><small>I am registering as university staff.</small></label>
                            </div>
                        </div>
                        <input asp-for="IsStudent" type="hidden" id="IsStudent" />
                        <input asp-for="IsStaff" type="hidden" id="IsStaff" />
                    </div>
                    <div class="registration-id-panel mb-4">
                        <div id="studentIdPanel" style="display:@(Model.IsStaff ? "none" : "block")">
                            <label asp-for="StudentNumber" class="form-label fw-semibold"></label>
                            <input asp-for="StudentNumber" class="form-control" placeholder="Enter your 10-digit student number" inputmode="numeric" minlength="10" maxlength="10" pattern="[0-9]{10}" autocomplete="off" />
                            <span asp-validation-for="StudentNumber" class="text-danger"></span>
                            <small class="text-muted">Enter exactly 10 digits. Your sign-in address will be this number followed by @@ufs4life.ac.za.</small>
                        </div>
                        <div id="staffIdPanel" style="display:@(Model.IsStudent ? "none" : "block")">
                            <label asp-for="EmployeeNumber" class="form-label fw-semibold"></label>
                            <input asp-for="EmployeeNumber" class="form-control" placeholder="Enter your 6-digit employee number" inputmode="numeric" minlength="6" maxlength="6" pattern="[0-9]{6}" autocomplete="off" />
                            <span asp-validation-for="EmployeeNumber" class="text-danger"></span>
                            <small class="text-muted">Enter exactly 6 digits. Your sign-in address will be this number followed by @@ufs.ac.za.</small>
                        </div>
                        <div id="typeHint" class="text-muted small @(((Model?.IsStudent ?? false) || (Model?.IsStaff ?? false)) ? "d-none" : "")"><i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>Choose Student or Staff member above to enter your number.</div>
                        <div id="generatedAddressPreview" class="small fw-semibold mt-3" aria-live="polite">Select an account type and enter your number to see your sign-in address.</div>
                        <div class="form-text">This address is your login name inside Bricks &amp; Books; it does not create or activate a UFS email mailbox.</div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
                        <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
                        <div class="col-12"><label asp-for="Email" class="form-label">Personal contact email</label><input asp-for="Email" type="email" class="form-control" autocomplete="email" placeholder="you@example.com" /><div class="form-text">Use an email address you check regularly. It is stored for residence contact and password-recovery requests. You sign in with the generated address shown above, not this personal email.</div><span asp-validation-for="Email" class="text-danger"></span></div>
                        <div class="col-md-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" type="password" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
                        <div class="col-md-6"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
                    </div>
                    <div class="alert alert-info mt-4 small"><i class="fa-solid fa-shield-halved me-2" aria-hidden="true"></i>Financial officer and administrator access is approved and assigned by an existing administrator after registration.</div>
                    <button type="submit" class="btn btn-primary w-100 mt-2"><i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>Create account</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (() => {
            const studentChoice = document.getElementById('studentChoice');
            const staffChoice = document.getElementById('staffChoice');
            const studentFlag = document.getElementById('IsStudent');
            const staffFlag = document.getElementById('IsStaff');
            const studentPanel = document.getElementById('studentIdPanel');
            const staffPanel = document.getElementById('staffIdPanel');
            const studentNumber = document.getElementById('StudentNumber');
            const employeeNumber = document.getElementById('EmployeeNumber');
            const typeHint = document.getElementById('typeHint');
            const addressPreview = document.getElementById('generatedAddressPreview');
            let selectedType = studentChoice.checked ? 'student' : staffChoice.checked ? 'staff' : '';

            const updateAddressPreview = () => {
                const number = selectedType === 'student' ? studentNumber.value.trim()
                    : selectedType === 'staff' ? employeeNumber.value.trim() : '';
                const expected = selectedType === 'student' ? 10 : 6;
                const domain = selectedType === 'student' ? '@@ufs4life.ac.za' : '@@ufs.ac.za';
                if (!selectedType) addressPreview.textContent = 'Select an account type and enter your number to see your sign-in address.';
                else if (number.length === expected && new RegExp('^[0-9]{' + expected + '}$').test(number))
                    addressPreview.textContent = 'Your Bricks & Books sign-in address: ' + number + domain;
                else addressPreview.textContent = 'Enter exactly ' + expected + ' digits to preview your sign-in address.';
            };

            const setType = (type) => {
                selectedType = type;
                const isStudent = type === 'student';
                studentChoice.checked = isStudent;
                staffChoice.checked = !isStudent;
                studentFlag.value = isStudent ? 'true' : 'false';
                staffFlag.value = isStudent ? 'false' : 'true';
                studentPanel.style.display = isStudent ? 'block' : 'none';
                staffPanel.style.display = isStudent ? 'none' : 'block';
                studentNumber.disabled = !isStudent;
                employeeNumber.disabled = isStudent;
                studentNumber.required = isStudent;
                employeeNumber.required = !isStudent;
                typeHint.classList.add('d-none');
                if (isStudent) employeeNumber.value = '';
                else studentNumber.value = '';
                updateAddressPreview();
            };

            studentChoice.addEventListener('change', () => setType('student'));
            staffChoice.addEventListener('change', () => setType('staff'));
            studentNumber.addEventListener('input', updateAddressPreview);
            employeeNumber.addEventListener('input', updateAddressPreview);
            if (selectedType) setType(selectedType);
            else updateAddressPreview();
        })();
    </script>
}

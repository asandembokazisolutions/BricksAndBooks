@model IEnumerable<BricksAndBooks.Models.PasswordResetRequest>

@{
    ViewData["Title"] = "Password reset requests";
}

<section class="workspace-hero" aria-labelledby="password-reset-title">
    <div>
        <p class="eyebrow mb-2">Accounts / Security</p>
        <h1 id="password-reset-title" class="mb-2">@ViewData["Title"]</h1>
        <p class="mb-0">Staff and students who couldn't sign in and asked for a new password.</p>
    </div>
</section>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success mt-3">@statusMessage</div>
}

<div class="table-responsive report-table-wrap mt-3">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Requested by</th>
                <th>Email</th>
                <th>Requested</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.User?.FirstName @request.User?.LastName</td>
                    <td>@request.User?.Email</td>
                    <td>@request.RequestedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                    <td class="text-end">
                        <form asp-action="ResolvePasswordResetRequest" asp-route-id="@request.Id" method="post" class="d-inline" onsubmit="return confirm('Issue a new temporary password for ' + '@request.User?.Email' + '?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-key me-1"></i>Issue new password</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-muted text-center py-4">No pending password reset requests.</td></tr>
            }
        </tbody>
    </table>
</div>

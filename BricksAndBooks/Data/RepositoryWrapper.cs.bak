using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace BricksAndBooks.Data
{
    public class RepositoryWrapper : IRepositoryWrapper
    {
        private BricksAndBooks.Data.DataAccess.AppDbContext _repoContext;
        // We'll use lazy loading for each repository.
        private IAccommodationRepository _accommodation;
        private IUnitRepository _unit;
        private ITariffRepository _tariff;
        private IBillRepository _bill;
        private IPaymentRepository _payment;
        private IMaintenanceRequestRepository _maintenanceRequest;
        private IChatMessageRepository _chatMessage;
        private INotificationRepository _notification;
        private IVehicleRepository _vehicle;
        private IOccupancyRepository _occupancy;
        private IReviewRepository _review;
        private IAuditLogRepository _auditLog;

        public RepositoryWrapper(BricksAndBooks.Data.DataAccess.AppDbContext repoContext)
        {
            _repoContext = repoContext;
        }

        public IAccommodationRepository Accommodation
        {
            get
            {
                if (_accommodation == null)
                {
                    _accommodation = new AccommodationRepository(_repoContext);
                }
                return _accommodation;
            }
        }

        public IUnitRepository Unit
        {
            get
            {
                if (_unit == null)
                {
                    _unit = new UnitRepository(_repoContext);
                }
                return _unit;
            }
        }

        public ITariffRepository Tariff
        {
            get
            {
                if (_tariff == null)
                {
                    _tariff = new TariffRepository(_repoContext);
                }
                return _tariff;
            }
        }

        public IBillRepository Bill
        {
            get
            {
                if (_bill == null)
                {
                    _bill = new BillRepository(_repoContext);
                }
                return _bill;
            }
        }

        public IPaymentRepository Payment
        {
            get
            {
                if (_payment == null)
                {
                    _payment = new PaymentRepository(_repoContext);
                }
                return _payment;
            }
        }

        public IMaintenanceRequestRepository MaintenanceRequest
        {
            get
            {
                if (_maintenanceRequest == null)
                {
                    _maintenanceRequest = new MaintenanceRequestRepository(_repoContext);
                }
                return _maintenanceRequest;
            }
        }

        public IChatMessageRepository ChatMessage
        {
            get
            {
                if (_chatMessage == null)
                {
                    _chatMessage = new ChatMessageRepository(_repoContext);
                }
                return _chatMessage;
            }
        }

        public INotificationRepository Notification
        {
            get
            {
                if (_notification == null)
                {
                    _notification = new NotificationRepository(_repoContext);
                }
                return _notification;
            }
        }

        public IVehicleRepository Vehicle
        {
            get
            {
                if (_vehicle == null)
                {
                    _vehicle = new VehicleRepository(_repoContext);
                }
                return _vehicle;
            }
        }

        public IOccupancyRepository Occupancy
        {
            get
            {
                if (_occupancy == null)
                {
                    _occupancy = new OccupancyRepository(_repoContext);
                }
                return _occupancy;
            }
        }

        public IReviewRepository Review
        {
            get
            {
                if (_review == null)
                {
                    _review = new ReviewRepository(_repoContext);
                }
                return _review;
            }
        }

        public IAuditLogRepository AuditLog
        {
            get
            {
                if (_auditLog == null)
                {
                    _auditLog = new AuditLogRepository(_repoContext);
                }
                return _auditLog;
            }
        }

        public void Save()
        {
            _repoContext.SaveChanges();
        }
    }
}